    let bytes;
    try {
      const empty = new Uint8Array;
      const response = await deps.transport.fetch(url, {
        method: prepared.request.method,
        headers: authorize(prepared.request.headers, granted.auth_material, url, empty),
        signal
      }, deps.config.allow_private_upstream, deps.config.private_upstream_cidrs);
      if (!response.ok) {
        await response.body?.cancel().catch(() => {
          return;
        });
        throw upstreamFailure(response.status);
      }
      if (action === "content") {
        clearTimeout(timer);
        const type = response.headers.get("content-type") ?? "";
        return new Response(response.body, {
          status: 200,
          headers: {
            "content-type": contentType.test(type) ? type : "application/octet-stream",
            "cache-control": "no-store",
            "x-request-id": request.requestId
          }
        });
      }
      bytes = await readBounded(response.body, deps.config.max_response_bytes, signal);
    } finally {
      clearTimeout(timer);
    }
    const transformed = await attempt.transformJSON("resource_response", {
      action,
      resource_id: resolution.resource_id,
      ...resolution.model ? { model: resolution.model } : {}
    }, bytes, signal);
    if (transformed.result.kind !== "output" || !transformed.body)
      throw new GatewayError(502, "upstream_invalid_response", "The upstream response was invalid");
    if (action === "delete")
      await permit(deps, request, {
        resource_id: resourceId,
        action,
        granted_command_id: commandId
      });
    let body = transformed.body;
    if (resolution.kind === "batch") {
      const remote = [...new Set(Object.values(batchFiles(body).files))];
      const mapped = remote.length ? (await permit(deps, request, {
        resource_id: resourceId,
        action: "files",
        remote_ids: remote
      })).files : {};
      body = exposeBatchFiles(body, new Map(Object.entries(mapped ?? {})));
    }
    return new Response(body.slice(), {
      status: 200,
      headers: { "content-type": "application/json", "x-request-id": request.requestId }
