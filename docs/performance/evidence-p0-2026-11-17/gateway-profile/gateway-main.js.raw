    return await deps.core.execution("execution_resource_v1", { customer_token: request.token, ip: request.ip, ...data }, { ...commandId ? { commandId } : {}, deadlineAt: deadline() });
  } catch (error) {
    throw coreFailure(error);
  }
}
function resourceURL(deps, base, path) {
  try {
    const origin = validateBaseUrl(base, deps.config.allow_private_upstream, deps.config.private_upstream_cidrs);
    const url = new URL(path, origin);
    if (url.origin !== origin.origin)
      throw new Error("origin");
    return url;
  } catch {
    throw new GatewayError(502, "unsafe_upstream", "The upstream address is not permitted");
  }
}
function upstreamFailure(status) {
  return status === 404 ? new GatewayError(404, "not_found", "Resource not found") : new GatewayError(502, "resource_upstream_failed", "Original provider could not complete the resource operation");
}
async function executeResource(deps, request, resourceId, action) {
  if (!/^(response|file|batch|video)_[0-9a-f]{32}$/.test(resourceId))
    throw new GatewayError(404, "not_found", "Resource not found");
  const resolved = await permit(deps, request, { resource_id: resourceId, action });
  const resolution = resolved.resolution, deadlineAt = Date.parse(resolution.deadline_at);
  const pkg = await deps.packages.get(resolution.package_digest, resolution.deadline_at).catch(() => {
    throw new GatewayError(503, "plugin_unavailable", "The resource's plugin is unavailable");
  });
  const owner = await deps.core.startup();
  const attempt = deps.host.create(pkg, {
    tenant: resolution.resource_id,
    attempt: crypto.randomUUID(),
    incarnation: owner.incarnation_id,
    config: resolution.config,
    deadlineAt
  });
  try {
    const prepared = await attempt.invoke("resource_prepare", new TextEncoder().encode(JSON.stringify({ kind: resolution.kind, action, remote_id: resolution.remote_id })), request.signal);
    if (prepared.kind === "failure")
      throw new GatewayError(prepared.status === 502 ? 502 : 422, prepared.status === 502 ? "plugin_invalid" : "unsupported_capability", "The resource's plugin cannot perform this action");
    if (prepared.kind !== "resource_request")
      throw new GatewayError(502, "plugin_invalid", "The resource's plugin returned no request");
    const url = resourceURL(deps, resolution.origin, prepared.request.path);
    const commandId = crypto.randomUUID();
    const granted = await permit(deps, request, { resource_id: resourceId, action, auth: prepared.request.auth }, commandId);
    if (granted.state !== "GRANTED" || !granted.auth_material)
      throw new GatewayError(503, "resource_unavailable", "The resource action was not granted");
    const expiry = new AbortController, timer = setTimeout(() => expiry.abort(), Math.max(1, deadlineAt - Date.now()));
