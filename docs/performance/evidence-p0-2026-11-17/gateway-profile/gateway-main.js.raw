    attempt.dispose();
  }
}
async function listResources(deps, request, kind, query) {
  const limit = query.limit === undefined ? 100 : Number(query.limit);
  if (!Number.isInteger(limit) || limit < 1 || limit > 100)
    throw new GatewayError(400, "invalid_request", "limit must be an integer from 1 to 100");
  if (query.after !== undefined && !new RegExp(`^${kind}_[0-9a-f]{32}$`).test(query.after))
    throw new GatewayError(404, "not_found", "Resource cursor not found");
  let page;
  try {
    page = await deps.core.execution("execution_resource_list_v1", {
      customer_token: request.token,
      ip: request.ip,
      kind,
      limit,
      ...query.after ? { after: query.after } : {}
    }, { deadlineAt: deadline(10) });
  } catch (error) {
    throw coreFailure(error);
  }
  const rows = page.data.slice(0, limit);
  return Response.json({
    object: "list",
    has_more: page.data.length > limit,
    first_id: rows[0]?.id ?? null,
    last_id: rows.at(-1)?.id ?? null,
    data: rows.map((row) => ({
      id: row.id,
      object: kind,
      status: row.state,
      created_at: row.created_at
    }))
  }, { headers: { "x-request-id": request.requestId } });
}

// apps/gateway/src/app.ts
var pluginCapacity = new Set([
  "ATTEMPT_BUDGET",
  "PENDING_BUDGET",
  "QUEUE_TIMEOUT",
  "STATE_BUDGET"
]);
function errorResponse(error, requestId) {
  const known = error instanceof GatewayError;
  return Response.json({
    error: {
      type: known ? error.code : "internal_error",
      code: known ? error.code : "internal_error",
      message: known ? error.message : "The gateway could not complete this request"
    },
    request_id: requestId
  }, { status: known ? error.status : 500, headers: { "x-request-id": requestId } });
}
function released(response, release) {
  if (!response.body) {
    release();
    return response;
  }
  const reader = response.body.getReader();
  let done = false;
  const finish = () => {
    if (!done) {
      done = true;
      release();
    }
  };
  return new Response(new ReadableStream({
    async pull(controller) {
      try {
        const next = await reader.read();
        if (next.done) {
          finish();
          controller.close();
        } else
          controller.enqueue(next.value);
      } catch (error) {
        finish();
        controller.error(error);
      }
    },
    async cancel(reason) {
      try {
        await reader.cancel(reason);
      } finally {
        finish();
      }
    }
  }), { status: response.status, headers: response.headers });
}
function createGatewayApp(deps) {
  const app = new Hono2;
  app.get("/livez", (c) => c.json({ status: "alive" }));
  app.get("/readyz", async (c) => {
    if (!deps.lifecycle.accepting)
      return c.json({ status: "draining" }, 503);
    try {
      await deps.ready();
      return c.json({ status: "ready" });
    } catch {
      return c.json({ status: "unavailable" }, 503);
    }
  });
  function serve(c, operation, path) {
    return handle(c, (inbound) => executeChat(deps, { ...inbound, operation, ...path ? { path } : {} }));
  }
  async function handle(c, run) {
    const requestId = crypto.randomUUID();
    let release;
    try {
      const authorization = c.req.header("authorization");
      const token = authorization?.startsWith("Bearer ") ? authorization.slice(7) : c.req.header("x-api-key") ?? c.req.header("x-goog-api-key") ?? "";
      if (!/^gw_[A-Za-z0-9_-]{43}$/.test(token))
        throw new GatewayError(401, "unauthenticated", "A valid project API key is required");
      const declared = Number(c.req.header("content-length") ?? 0);
      if (declared > deps.config.max_body_bytes)
        throw new GatewayError(413, "body_too_large", "Request body exceeds limit");
      const ip = clientAddress(c.env.peerAddress, c.req.header("x-forwarded-for") ?? null, deps.config.trusted_proxy_cidrs);
      if (!ip)
        throw new GatewayError(400, "invalid_client_address", "Client address unavailable");
      const entered = deps.lifecycle.enter();
      release = entered.release;
      const signal = AbortSignal.any([c.req.raw.signal, entered.controller.signal]);
      const body = await readBounded(c.req.raw.body, deps.config.max_body_bytes, signal);
      const response = await deps.lifecycle.track(run({
        requestId,
        body,
        contentType: c.req.header("content-type"),
        token,
        ip,
        idempotencyKey: c.req.header("idempotency-key"),
        signal: c.req.raw.signal,
        drain: entered.controller.signal
      }));
      const settled = release;
      release = undefined;
      return released(response, settled);
    } catch (error) {
      release?.();
      return errorResponse(error instanceof GatewayError && error.code === "overloaded" || error instanceof PluginHostError && pluginCapacity.has(error.code) ? new GatewayError(503, deps.lifecycle.accepting ? "overloaded" : "draining", "Gateway admission capacity reached") : error, requestId);
    }
  }
  app.post("/v1/chat/completions", (c) => serve(c, "chat"));
  app.post("/v1/messages", (c) => serve(c, "messages"));
  app.post("/v1/responses", (c) => serve(c, "responses"));
  app.post("/v1/files", (c) => serve(c, "files"));
  app.post("/v1/batches", (c) => serve(c, "batches"));
  app.post("/v1/videos", (c) => serve(c, "videos"));
  app.get("/v1/videos", (c) => handle(c, (inbound) => listResources(deps, inbound, "video", {
    limit: c.req.query("limit"),
    after: c.req.query("after")
  })));
  app.get("/v1/videos/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "get")));
  app.delete("/v1/videos/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "delete")));
  app.get("/v1/videos/:id/content", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "content")));
  app.get("/v1/batches", (c) => handle(c, (inbound) => listResources(deps, inbound, "batch", {
    limit: c.req.query("limit"),
    after: c.req.query("after")
  })));
  app.get("/v1/batches/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "get")));
  app.post("/v1/batches/:id/cancel", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "cancel")));
  app.get("/v1/files", (c) => handle(c, (inbound) => listResources(deps, inbound, "file", {
    limit: c.req.query("limit"),
    after: c.req.query("after")
  })));
  app.get("/v1/files/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "get")));
  app.delete("/v1/files/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "delete")));
  app.get("/v1/files/:id/content", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "content")));
  app.get("/v1/responses", (c) => handle(c, (inbound) => listResources(deps, inbound, "response", {
    limit: c.req.query("limit"),
    after: c.req.query("after")
  })));
  app.get("/v1/responses/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "get")));
  app.delete("/v1/responses/:id", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "delete")));
  app.post("/v1/responses/:id/cancel", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "cancel")));
  app.get("/v1/responses/:id/input_items", (c) => handle(c, (inbound) => executeResource(deps, inbound, c.req.param("id"), "input_items")));
  app.post("/v1/embeddings", (c) => serve(c, "embeddings"));
  app.post("/v1/moderations", (c) => serve(c, "moderations"));
  app.post("/v1/completions", (c) => serve(c, "completions"));
  app.post("/v1/images/generations", (c) => serve(c, "images"));
  app.post("/v1/images/edits", (c) => serve(c, "image_edits"));
  app.post("/v1/audio/speech", (c) => serve(c, "speech"));
  app.post("/v1/audio/transcriptions", (c) => serve(c, "transcription"));
  app.post("/v1/audio/translations", (c) => serve(c, "translation"));
  app.post("/v1/music/generations", (c) => serve(c, "music"));
  app.post("/v1beta/models/:action", (c) => {
    const match = /^([A-Za-z0-9._-]{1,200}):(generateContent|streamGenerateContent)$/.exec(c.req.param("action"));
    if (!match)
      return errorResponse(new GatewayError(404, "not_found", "Unknown Gemini operation"), crypto.randomUUID());
    return serve(c, "gemini", {
      model: match[1],
      stream: match[2] === "streamGenerateContent"
    });
  });
  app.notFound(() => errorResponse(new GatewayError(404, "not_found", "Unknown endpoint"), crypto.randomUUID()));
  return app;
}

// apps/gateway/src/config.ts
var cidrs = array(string2().max(64)).max(64).default([]);
var configSchema = strictObject({
  hostname: string2().min(1),
  port: number2().int().min(0).max(65535),
  max_body_bytes: number2().int().positive().max(16 << 20).default(16 << 20),
  max_response_bytes: number2().int().positive().max(64 << 20).default(32 << 20),
  total_timeout_ms: number2().int().min(1000).max(600000).default(180000),
  upstream_header_timeout_ms: number2().int().min(100).max(600000).default(30000),
  upstream_idle_timeout_ms: number2().int().min(100).max(600000).default(30000),
  downstream_stall_timeout_ms: number2().int().min(100).max(600000).default(30000),
  max_inflight: number2().int().positive().max(1e5).default(1024),
  quota_renew_ms: number2().int().min(100).max(20000).default(1e4),
  resource_poll_ms: number2().int().min(100).max(600000).default(5000),
  shutdown_grace_ms: number2().int().min(100).max(120000).default(20000),
  trusted_proxy_cidrs: cidrs,
  allow_private_upstream: boolean2().default(false),
  private_upstream_cidrs: cidrs,
  upstream_pool_size: number2().int().positive().max(65536).default(1024),
  core: strictObject({
    origin: string2().url(),
    servername: string2().min(1),
    audience: string2().regex(coreAudiencePattern),
    peer_sha256: string2().regex(/^[a-f0-9]{64}$/),
    subject_altname: string2().min(1).max(2000),
    key_file: string2().min(1),
    cert_file: string2().min(1),
    ca_file: string2().min(1)
  }),
  queue: strictObject({
    url: string2().startsWith("redis"),
    namespace: string2().regex(/^[a-zA-Z0-9:_-]{1,80}$/),
    required_replicas: number2().int().min(0).max(5),
    ack_timeout_ms: number2().int().min(100).max(1e4).default(2000)
  }),
  plugins: strictObject({
    helper_executable: string2().min(1),
    trust_policy: string2().min(1)
  }),
  production: boolean2().default(false)
});
async function loadGatewayConfig(path = process.env.GATEWAY_CONFIG_FILE) {
  if (!path)
    throw new Error("GATEWAY_CONFIG_FILE required");
  const config = configSchema.parse(await Bun.file(path).json());
  for (const cidr of [...config.trusted_proxy_cidrs, ...config.private_upstream_cidrs])
    validateCidr(cidr);
  if (config.production && config.allow_private_upstream)
    throw new Error("Production forbids private upstream bypass");
  if (config.production && config.queue.required_replicas < 1)
    throw new Error("Production requires an acknowledged AOF replica for evidence");
  return config;
}

// apps/gateway/src/packages.ts
async function loadPackageTrust(path, now = Date.now()) {
  return packageTrust(releasePolicySchema.parse(await Bun.file(path).json()), now);
}
function createPackageCache(download, trust, capacity = 8) {
  const verified = new Map;
  const pending = new Map;
  async function fetchVerified(digest, deadlineAt) {
    const keys = trust(digest);
    if (keys.size === 0)
      throw new Error("Plugin package is not trusted by this deployment");
    const pkg = verifyPackage(await download(digest, deadlineAt), keys);
    if (pkg.digest !== digest)
      throw new Error("Plugin package digest mismatch");
    if (!trust.admits(pkg))
      throw new Error("Plugin package is not trusted by this deployment");
    if (verified.size >= capacity)
      verified.delete(verified.keys().next().value);
    verified.set(digest, pkg);
    return pkg;
  }
  return {
    get(digest, deadlineAt) {
      const cached = verified.get(digest);
      if (cached) {
        verified.delete(digest);
        verified.set(digest, cached);
        return Promise.resolve(cached);
      }
      let task = pending.get(digest);
      if (!task) {
        task = fetchVerified(digest, deadlineAt).finally(() => pending.delete(digest));
        pending.set(digest, task);
      }
      return task;
    },
    size: () => verified.size
  };
}

// apps/gateway/src/resource-poller.ts
var retry = { state: "ACTIVE", retry: true };
function deadline2(seconds) {
  return new Date(Date.now() + seconds * 1000).toISOString();
}
async function record3(deps, lease, outcome, source = "async_final") {
  await deps.publish([
    deps.core.signEvidence({
      event_id: crypto.randomUUID(),
      attempt_id: lease.attempt_id,
      permit_epoch: lease.permit_epoch,
      source,
      source_revision: lease.lease_epoch,
      final_dimensions: outcome.finality === "FINAL" ? pricedDimensions(outcome.usage) : [],
      ...outcome
    })
  ]);
}
async function upstream(deps, lease, open, target, signal) {
  const resolution = lease.resolution;
  const attempt = open();
  try {
    const prepared = await attempt.invoke("resource_prepare", new TextEncoder().encode(JSON.stringify(target)), signal);
    if (prepared.kind !== "resource_request")
      return;
    const url = resourceURL(deps, resolution.origin, prepared.request.path);
    const granted = await deps.core.execution("execution_resource_poll_v1", {
      resource_id: resolution.resource_id,
      lease_epoch: lease.lease_epoch,
      auth: prepared.request.auth
    }, { commandId: crypto.randomUUID(), deadlineAt: resolution.deadline_at });
    return await deps.transport.fetch(url, {
      method: prepared.request.method,
      headers: authorize(prepared.request.headers, granted.auth_material, url, new Uint8Array),
      signal
    }, deps.config.allow_private_upstream, deps.config.private_upstream_cidrs);
  } finally {
    attempt.dispose();
  }
}
var batchOutcomes = {
  completed: {
    source: "batch_completed",
    release: "COMPLETED",
    attempt_state: "SUCCEEDED",
    request_state: "SUCCEEDED"
  },
  cancelled: {
    source: "batch_cancelled",
    release: "CANCELLED",
    attempt_state: "SUCCEEDED",
    request_state: "CANCELLED"
  },
  failed: {
    source: "batch_failed",
    release: "FAILED",
    attempt_state: "FAILED",
    request_state: "FAILED"
  },
  expired: {
    source: "batch_failed",
    release: "FAILED",
    attempt_state: "FAILED",
    request_state: "FAILED"
  }
};
async function observeBatch(deps, lease, open, signal) {
  const resolution = lease.resolution, batch = resolution.batch;
  if (!batch || !resolution.model)
    return retry;
  const response = await upstream(deps, lease, open, { kind: "batch", action: "get", remote_id: resolution.remote_id }, signal);
  if (!response?.ok) {
    await response?.body?.cancel().catch(() => {
      return;
    });
    return retry;
  }
  const bytes = await readBounded(response.body, deps.config.max_response_bytes, signal);
  const viewer = open();
  let body;
  try {
    const transformed = await viewer.transformJSON("resource_response", { action: "get", resource_id: resolution.resource_id, model: resolution.model }, bytes, signal);
    if (transformed.result.kind !== "output")
      return retry;
    body = transformed.body;
  } finally {
    viewer.dispose();
  }
  if (!body)
    return retry;
  const observed = batchFiles(body), outcome = typeof observed.status === "string" ? batchOutcomes[observed.status] : undefined;
  if (!outcome)
    return { state: "ACTIVE", retry: false };
  const usage = {}, seen = new Set;
  let complete = true;
  for (const remote of [observed.files.output_file_id, observed.files.error_file_id]) {
    if (!remote)
      continue;
    const file = await upstream(deps, lease, open, { kind: "file", action: "content", remote_id: remote }, signal);
    if (!file?.ok) {
      await file?.body?.cancel().catch(() => {
        return;
      });
      return retry;
    }
    let lines;
    try {
      lines = parseBatchOutput(await readBounded(file.body, deps.config.max_response_bytes, signal));
    } catch {
      return retry;
    }
    for (const line of lines) {
      if (seen.has(line.customId))
        complete = false;
      seen.add(line.customId);
    }
    const metadata = batchMetadata(batch.endpoint, resolution.model);
    let next = 0;
    const work = async () => {
      while (next < lines.length) {
        const line = lines[next++];
        if (!line.body)
          continue;
        const reader = open();
        try {
          const { result } = await reader.transformJSON("response", metadata, line.body, signal);
          if (result.kind === "output" && result.usage)
            sumQuantities(usage, result.usage);
          if (result.kind !== "output" || result.finality !== "FINAL")
            complete = false;
        } catch {
          complete = false;
        } finally {
          reader.dispose();
        }
      }
    };
    await Promise.all(Array.from({ length: 4 }, work));
  }
  if (seen.size !== batch.items || batchIdentityDigest(seen) !== batch.ids_sha256)
    complete = false;
  const priced = Object.keys(usage).length > 0;
  await record3(deps, lease, {
    usage,
    finality: priced ? complete ? "FINAL" : "PARTIAL" : "UNKNOWN",
    attempt_state: outcome.attempt_state,
    request_state: outcome.request_state,
    ...outcome.attempt_state === "FAILED" ? { error_code: `batch_${observed.status}` } : {}
  }, outcome.source);
  return { state: outcome.release, retry: false };
}
async function observe(deps, lease, stop) {
  const resolution = lease.resolution, deadlineAt = Date.parse(resolution.deadline_at);
  if (!["response", "batch", "video"].includes(resolution.kind) || !resolution.model)
    return retry;
  const pkg = await deps.packages.get(resolution.package_digest, resolution.deadline_at);
  const owner = await deps.core.startup();
  const open = () => deps.host.create(pkg, {
    tenant: resolution.resource_id,
    attempt: crypto.randomUUID(),
    incarnation: owner.incarnation_id,
    config: resolution.config,
    deadlineAt
  });
  const signal = AbortSignal.any([stop, AbortSignal.timeout(Math.max(1, deadlineAt - Date.now()))]);
  if (resolution.kind === "batch")
    return observeBatch(deps, lease, open, signal);
  const attempt = open();
  try {
    const response = await upstream(deps, lease, open, { kind: resolution.kind, action: "get", remote_id: resolution.remote_id }, signal);
    if (!response)
      return retry;
    if (!response.ok) {
      await response.body?.cancel().catch(() => {
        return;
      });
      if (response.status !== 404 || resolution.state !== "DELETED")
        return retry;
      await record3(deps, lease, {
        usage: {},
        finality: "UNKNOWN",
        attempt_state: "FAILED",
        request_state: "FAILED",
        error_code: "resource_deleted"
      });
      return { state: "FAILED", retry: false };
    }
    const bytes = await readBounded(response.body, deps.config.max_response_bytes, signal);
    const { result } = await attempt.transformJSON("response", {
      ...resolution.kind === "video" ? { operation: "videos" } : { protocol: "responses" },
      model: resolution.model,
      resource_id: resolution.resource_id
    }, bytes, signal);
    if (result.kind === "failure") {
      if (result.code !== "upstream_error")
        return retry;
      await record3(deps, lease, {
        usage: {},
        finality: "UNKNOWN",
        attempt_state: "FAILED",
        request_state: "FAILED",
        error_code: "upstream_error"
      });
      return { state: "FAILED", retry: false };
    }
    if (result.kind !== "output" || !result.terminal)
      return retry;
    if (result.terminal.kind === "pending")
      return { state: "ACTIVE", retry: false };
    await record3(deps, lease, {
      usage: { ...result.usage },
      finality: result.finality === "ESTIMATED" ? "UNKNOWN" : result.finality,
      attempt_state: "SUCCEEDED",
      request_state: "SUCCEEDED"
    });
    return { state: "COMPLETED", retry: false };
  } finally {
    attempt.dispose();
  }
}
async function pollResources(deps, stop = new AbortController().signal, limit = 4) {
  const claimed = await deps.core.execution("execution_resource_claim_v1", { limit }, { deadlineAt: deadline2(10) });
  await Promise.all(claimed.leases.map(async (lease) => {
    const outcome = await observe(deps, lease, stop).catch(() => retry);
    await deps.core.execution("execution_resource_release_v1", { resource_id: lease.resource_id, lease_epoch: lease.lease_epoch, ...outcome }, { deadlineAt: deadline2(10) }).catch(() => {
      return;
    });
  }));
  return claimed.leases.length;
}
function startResourcePolling(deps, intervalMs, onError) {
  const stop = new AbortController;
  let stopped = false, wake;
  const loop = (async () => {
    while (!stopped) {
      let claimed = 0;
      try {
        claimed = await pollResources(deps, stop.signal);
      } catch (error) {
        onError(error);
      }
      if (stopped || claimed > 0)
        continue;
      await new Promise((resolve) => {
        const timer = setTimeout(resolve, intervalMs);
        wake = () => {
          clearTimeout(timer);
          resolve();
        };
      });
      wake = undefined;
    }
  })();
  return {
    async close() {
      stopped = true;
      stop.abort();
      wake?.();
      await loop;
    }
  };
}

// apps/gateway/src/main.ts
var config4 = await loadGatewayConfig();
var trust = await loadPackageTrust(config4.plugins.trust_policy);
var core2 = createCoreRpcClient({
  origin: config4.core.origin,
  servername: config4.core.servername,
  audience: config4.core.audience,
  expectedPeerSha256: config4.core.peer_sha256,
  expectedSubjectAltname: config4.core.subject_altname,
  key: await Bun.file(config4.core.key_file).text(),
  cert: await Bun.file(config4.core.cert_file).text(),
  ca: await Bun.file(config4.core.ca_file).text()
});
var producer = new UsageProducer({
  channel: evidenceChannel,
  url: config4.queue.url,
  namespace: config4.queue.namespace,
  replicas: config4.queue.required_replicas,
  timeoutMs: config4.queue.ack_timeout_ms,
  maxInFlight: config4.max_inflight,
  requireAllReplicas: config4.production
});
var pluginAttempts = 128;
var host = createPluginAttempts(createPluginSupervisor({
  executable: config4.plugins.helper_executable,
  maxPending: pluginAttempts
}), { maxAttempts: pluginAttempts, maxStateBytes: pluginAttempts * (256 << 10) });
var transport = createTransport(config4.upstream_pool_size);
var grants = createSendRegistry();
var lifecycle2 = new Lifecycle(config4.max_inflight);
async function release() {
  transport.close();
  producer.close();
  await host.close();
  await core2.close();
}
try {
  await core2.startup();
  await producer.ready();
} catch (error) {
  await release();
  throw error;
}
var deps = {
  config: config4,
  core: core2,
  packages: createPackageCache((digest, deadlineAt) => core2.pluginPackage(digest, { deadlineAt }), trust),
  host,
  transport,
  grants,
  publish: (events) => producer.publish({ events })
};
var poller = startResourcePolling(deps, config4.resource_poll_ms, () => console.log(JSON.stringify({ service: "gateway", event: "resource_poll_failed" })));
var app = createGatewayApp({
  ...deps,
  lifecycle: lifecycle2,
  ready: async () => {
    await core2.current();
    await producer.ready();
  }
});
var server = Bun.serve({
  hostname: config4.hostname,
  port: config4.port,
  maxRequestBodySize: config4.max_body_bytes,
  idleTimeout: 30,
  fetch: async (request, server) => {
    const response = await app.fetch(request, {
      peerAddress: server.requestIP(request)?.address
    });
    if (response.headers.get("content-type")?.includes("text/event-stream"))
      server.timeout(request, 0);
    return response;
  },
  error: () => Response.json({ error: { code: "server_error", message: "Gateway server error" } }, { status: 500 })
});
console.log(JSON.stringify({ service: "gateway", event: "ready", port: server.port }));
var stopping = false;
async function shutdown() {
  if (stopping)
    return;
  stopping = true;
  lifecycle2.accepting = false;
  const stopped = server.stop(false);
  const drained = await lifecycle2.drain(config4.shutdown_grace_ms, 5000);
  grants.close();
  await poller.close();
  await Promise.race([stopped, Bun.sleep(1000)]);
  await server.stop(true);
  await release();
  console.log(JSON.stringify({ service: "gateway", event: "stopped", drained, grants: grants.size() }));
  process.exit(0);
}
process.on("SIGTERM", () => void shutdown());
process.on("SIGINT", () => void shutdown());
