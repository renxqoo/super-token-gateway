        {
          "pid": 2858,
          "duration_ms": 4.993,
          "query": "SELECT coalesce(array_agg(k ORDER BY k.id),'{}'::public.api_keys[])                  FROM public.api_keys k WHERE k.id IN(\n  SELECT c.key_id FROM jsonb_array_elements(items) i\n  LEFT JOIN public.execution_permits ep ON ep.attempt_id=CASE WHEN i->'projection'->>'command_type' IN('execution_begin_v1','execution_abort_v1') THEN (i->'data'->>'attempt_id')::uuid END\n  JOIN public.execution_contexts c ON c.id=CASE WHEN i->'projection'->>'command_type' IN('execution_admit_v1','execution_next_v1') THEN (i->'data'->>'context_id')::uuid ELSE ep.context_id END\n  WHERE i->'projection'->>'command_type' IN('execution_admit_v1','execution_next_v1','execution_begin_v1','execution_abort_v1')\n )",
