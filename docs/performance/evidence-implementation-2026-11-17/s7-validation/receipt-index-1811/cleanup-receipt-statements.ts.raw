import { SQL } from "bun";

const baseline = await Bun.file(".local/performance-implementation/foundation-resource-inspection.json").json();
const protectedDatabases = new Set(baseline.rows.map((row: { datname: string }) => row.datname));
const sources: { path: string; database: string; users: string[] }[] = [];
for (const root of ["docs/performance/evidence-implementation-2026-11-17", ".local/capacity"]) {
  for (const pattern of ["**/audit.json", "**/audit.json.raw"]) {
    for await (const relative of new Bun.Glob(pattern).scan({ cwd: root, onlyFiles: true })) {
      const path = `${root}/${relative}`;
      const audit = await Bun.file(path).json();
      if (audit.scope !== "v2-three-process" || !/^gateway_test_foundation_[a-f0-9]{32}$/.test(audit.database) || protectedDatabases.has(audit.database)) continue;
      const users = [...new Set<string>((audit.pgStatements?.top25 ?? []).map((row: { userid: string }) => String(row.userid)).filter((value: string) => /^[0-9]+$/.test(value) && BigInt(value) > 16384n))];
      if (users.length) sources.push({ path, database: audit.database, users });
    }
  }
}
const users = [...new Set(sources.flatMap(source => source.users))];
const url = new URL(process.env.DATABASE_URL!);
url.pathname = "/postgres";
const db = new SQL(url.toString(), { max: 1 });
try {
  const before = await db`SELECT (SELECT count(*) FROM pg_stat_statements)::int entries,dealloc::text,stats_reset::text FROM pg_stat_statements_info`;
  const candidates = await db`SELECT s.dbid::text dbid,array_agg(DISTINCT s.userid::text) users,count(*)::int statements FROM pg_stat_statements s WHERE s.userid=ANY(${users}::oid[]) AND NOT EXISTS(SELECT 1 FROM pg_database d WHERE d.oid=s.dbid) AND NOT EXISTS(SELECT 1 FROM pg_roles r WHERE r.oid=s.userid) GROUP BY s.dbid ORDER BY s.dbid`;
  const reset = [];
  for (const row of candidates) {
    const evidence = sources.filter(source => source.users.some(user => row.users.includes(user)));
    if (!evidence.length) throw new Error("missing ownership evidence");
    const stillAbsent = await db`SELECT NOT EXISTS(SELECT 1 FROM pg_database WHERE oid=${row.dbid}::oid) absent`;
    if (!stillAbsent[0].absent) throw new Error("database appeared before targeted reset");
    await db`SELECT pg_stat_statements_reset(0::oid,${row.dbid}::oid,0::bigint)`;
    reset.push({ ...row, sources: evidence });
  }
  const after = await db`SELECT (SELECT count(*) FROM pg_stat_statements)::int entries,dealloc::text,stats_reset::text FROM pg_stat_statements_info`;
  const result = { at: new Date().toISOString(), scope: "Only absent databases linked to this task's audits through deleted service role OIDs", before, after, reset };
  await Bun.write(".local/performance-implementation/receipt-index-statements-cleanup.json", JSON.stringify(result, null, 2) + "\n");
  console.log(JSON.stringify({ before, after, reset_databases: reset.length }));
} finally {
  await db.close();
}
