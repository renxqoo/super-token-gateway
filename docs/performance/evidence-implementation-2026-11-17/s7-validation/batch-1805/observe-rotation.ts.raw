import { SQL } from "bun";
const db = new SQL(process.env.DATABASE_URL!, { max: 1 });
const start = new Date().toISOString();
const samples: unknown[] = [];
let ended = false;
const child = Bun.spawn([
  ".local/toolchain/bun-1.4.4/bun", "--env-file=.env.local", "--env-file=.local/native-gate.env",
  "test", "tests/integration/core-evidence-authentication.test.ts", "-t", "normal rotation",
], { env: process.env, stdin: "ignore", stdout: Bun.file(".local/performance-implementation/s7-rotation-observed-test.log"), stderr: Bun.file(".local/performance-implementation/s7-rotation-observed-test-errors.log") });
const observe = (async () => {
  while (!ended) {
    const rows = await db`SELECT pid,datname,state,wait_event_type,wait_event,pg_blocking_pids(pid) blockers,left(query,220) query FROM pg_stat_activity WHERE pid<>pg_backend_pid() AND datname LIKE 'gateway_test_foundation_%' AND backend_start>=${start}::timestamptz ORDER BY pid`;
    samples.push({ at: new Date().toISOString(), rows });
    await Bun.sleep(250);
  }
})();
let exit: number;
try { exit = await child.exited; } finally { ended = true; await observe; await db.close(); }
await Bun.write(".local/performance-implementation/s7-rotation-pg-observation.json", JSON.stringify({ start, exit, samples }, null, 2) + "\n");
console.log(JSON.stringify({ exit, samples: samples.length }));
