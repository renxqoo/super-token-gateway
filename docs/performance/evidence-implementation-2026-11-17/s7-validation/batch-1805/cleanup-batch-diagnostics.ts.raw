import { SQL, RedisClient } from "bun";
import { readFile, rm, appendFile } from "node:fs/promises";
const names = ["gateway_test_foundation_df1d2da646c2484d9c979e61f36a6493", "gateway_test_foundation_498a92cfc0f54b42a8d28b9d56bbd189", "gateway_test_foundation_6d21e3c99b98462daeae0b5889441906"];
const rows = (await readFile(".local/identity-resources.jsonl", "utf8")).trim().split("\n").map(s => JSON.parse(s));
const segments = new Map<string, any[]>();
let current: any[] | undefined;
for (const row of rows) {
  if (row.event === "created") {
    current = names.includes(row.name) ? [] : undefined;
    if (current) segments.set(row.name, current);
  }
  current?.push(row);
}
const db = new SQL(process.env.DATABASE_URL!, { max: 1 });
const result: any = { at: new Date().toISOString(), databases: [], roles: [], directories: [], redis: [], ownership: [] };
try {
  for (const name of names) {
    const segment = segments.get(name);
    if (!segment || segment.some(r => r.event === "dropped")) throw new Error("Ownership record mismatch");
    for (const { pid } of segment.filter(r => r.event === "process_started")) {
      try { process.kill(pid, 0); throw new Error(`Owned PID still exists: ${pid}`); } catch (error: any) { if (error.code !== "ESRCH") throw error; }
    }
    const directory = segment.find(r => r.event === "temp_created")?.directory;
    if (!directory?.startsWith("/var/folders/49/bv4h4f1s29l1jzxbj_2npyb40000gn/T/gateway-identity-")) throw new Error("Directory ownership mismatch");
    const config = JSON.parse(await readFile(`${directory}/coreA.json`, "utf8"));
    if (new URL(config.database_url).pathname !== `/${name}`) throw new Error("Config database mismatch");
    const present = await db`SELECT datid::int oid,numbackends FROM pg_stat_database WHERE datname=${name}`;
    if (present.length !== 1 || present[0].numbackends !== 0) throw new Error("Owned database absent or active");
    const identityRoles = segment.filter(r => r.event === "role_created").map(r => r.role);
    const catalogRoles = await db`SELECT DISTINCT r.rolname role FROM pg_shdepend d JOIN pg_roles r ON r.oid=d.refobjid WHERE d.refclassid='pg_authid'::regclass AND d.dbid=${present[0].oid} AND r.rolname LIKE 'gateway_t04b1_%'`;
    if (catalogRoles.length !== 1) throw new Error("Catalog role identity mismatch");
    const roles = [...identityRoles, catalogRoles[0].role];
    const foreign = await db`SELECT r.rolname FROM pg_shdepend d JOIN pg_roles r ON r.oid=d.refobjid WHERE d.refclassid='pg_authid'::regclass AND r.rolname=ANY(${roles}::text[]) AND d.dbid<>${present[0].oid}`;
    if (foreign.length) throw new Error("Owned role has external dependencies");
    const catalogRows = (await readFile(".local/T04b1-resources.jsonl", "utf8")).trim().split("\n").map(s => JSON.parse(s));
    const index = catalogRows.findIndex(r => r.event === "role_created" && r.role === catalogRoles[0].role);
    const catalogDirectory = catalogRows[index - 1]?.directory;
    if (catalogRows[index - 1]?.event !== "temp_created" || !catalogDirectory?.startsWith("/var/folders/49/bv4h4f1s29l1jzxbj_2npyb40000gn/T/gateway-t04b1-")) throw new Error("Catalog directory identity mismatch");
    const namespace = config.execution.quotaNamespace;
    if (!/^financial_[a-f0-9]{32}$/.test(namespace)) throw new Error("Namespace identity mismatch");
    const redis = new RedisClient(process.env.REDIS_URL!, { autoReconnect: false, connectionTimeout: 1000 });
    let cursor = "0", removed = 0;
    try {
      await redis.connect();
      do {
        const [next, keys] = await redis.send("SCAN", [cursor, "MATCH", `${namespace}:*`, "COUNT", "100"]) as [string, string[]];
        if (keys.some(k => !k.startsWith(namespace + ":"))) throw new Error("Redis ownership mismatch");
        if (keys.length) removed += Number(await redis.send("DEL", keys));
        cursor = next;
      } while (cursor !== "0");
    } finally { redis.close(); }
    result.redis.push({ namespace, removed });
    await db.unsafe(`DROP DATABASE ${name}`);
    result.databases.push(name);
    for (const role of roles) {
      if (!/^(gateway_identity_(api|deployer|verifier)_|gateway_t04b1_)[a-f0-9]{32}$/.test(role)) throw new Error("Role ownership mismatch");
      await db.unsafe(`DROP ROLE ${role}`);
      result.roles.push(role);
    }
    for (const ownedDirectory of [directory, catalogDirectory]) { await rm(ownedDirectory, { recursive: true }); result.directories.push(ownedDirectory); }
    result.ownership.push({ database: name, config_database_equal: true, process_pids_absent: true, database_backends: 0, role_dependencies_only_owned_database: true });
    await appendFile(".local/identity-resources.jsonl", JSON.stringify({ event: "dropped", name, at: new Date().toISOString(), cleanup: "owned 1805 diagnostic after test timeout" }) + "\n");
  }
  result.remaining = await db`SELECT datname FROM pg_database WHERE datname=ANY(${names}::text[])`;
  result.foundation_count = (await db`SELECT count(*)::int n FROM pg_database WHERE datname LIKE 'gateway_test_foundation_%'`)[0].n;
} finally {
  await db.close();
  await Bun.write(".local/performance-implementation/s7-batch-diagnostic-cleanup.json", JSON.stringify(result, null, 2) + "\n");
}
console.log(JSON.stringify({ databases: result.databases.length, roles: result.roles.length, directories: result.directories.length, redis_removed: result.redis.reduce((n: number, r: any) => n + r.removed, 0), foundation_count: result.foundation_count }));
