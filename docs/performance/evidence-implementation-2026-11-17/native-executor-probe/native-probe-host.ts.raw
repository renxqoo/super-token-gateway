type Frame = { input: string; output?: string };
let current: Frame | undefined;
function frame() {
  if (!current) throw new Error("NATIVE_PROBE_SCOPE");
  return current;
}
export const Host = Object.freeze({
  inputString: () => frame().input,
  outputString(value: string) {
    const f = frame();
    if (f.output !== undefined) throw new Error("NATIVE_PROBE_DUPLICATE_OUTPUT");
    f.output = value;
  },
  base64ToArrayBuffer(value: string) {
    const bytes = Buffer.from(value, "base64");
    if (bytes.toString("base64") !== value) throw new Error("NATIVE_PROBE_BASE64");
    return bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
  },
  arrayBufferToBase64: (value: ArrayBuffer) => Buffer.from(value).toString("base64"),
});
export function scope(input: string, invoke: () => void): string {
  if (current) throw new Error("NATIVE_PROBE_REENTRANT");
  const f: Frame = { input };
  current = f;
  try {
    invoke();
    if (f.output === undefined) throw new Error("NATIVE_PROBE_OUTPUT");
    return f.output;
  } finally {
    current = undefined;
  }
}
