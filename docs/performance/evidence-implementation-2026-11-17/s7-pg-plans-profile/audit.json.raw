        "query": "SELECT coalesce(array_agg(k ORDER BY k.id),$2::public.api_keys[])                  FROM public.api_keys k WHERE k.id IN(\n  SELECT c.key_id FROM jsonb_array_elements(items) i\n  LEFT JOIN public.execution_permits ep ON ep.attempt_id=CASE WHEN i->$3->>$4 IN($5,$6) THEN (i->$7->>$8)::uuid END\n  JOIN public.execution_contexts c ON c.id=CASE WHEN i->$9->>$10 IN($11,$12) THEN (i->$13->>$14)::uuid ELSE ep.context_id END\n  WHERE i->$15->>$16 IN($17,$18,$19,$20)\n )",
