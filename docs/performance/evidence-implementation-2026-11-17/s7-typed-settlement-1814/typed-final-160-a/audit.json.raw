        "queryid": "-4663971676636834392",
        "toplevel": false,
        "query": "INSERT INTO public.execution_permits(attempt_id,command_id,gateway_instance_id,owner_session_id,owner_key_sha256,owner_service,certificate_sha256,incarnation_id,permit_epoch,binding_id,dispatched_digest,state,expires_at,route_id,context_id,snapshot,manifest,manifest_digest,candidate_digest,authorization_plan_digest,prep_session_id,prep_binding_digest)\n  SELECT ep.attempt_id,ep.command_id,ep.gateway_instance_id,ep.owner_session_id,ep.owner_key_sha256,ep.owner_service,ep.certificate_sha256,ep.incarnation_id,ep.permit_epoch,ep.binding_id,ep.dispatched_digest,ep.state,ep.expires_at,ep.route_id,ep.context_id,ep.snapshot,ep.manifest,ep.manifest_digest,ep.candidate_digest,ep.authorization_plan_digest,ep.prep_session_id,ep.prep_binding_digest\n  FROM jsonb_each(pending->$2) a CROSS JOIN LATERAL jsonb_populate_record($3::public.execution_permits,a.value->$4) ep",
