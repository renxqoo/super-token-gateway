        "query": "WITH closed AS (\n  UPDATE public.gateway_requests q SET execution_closed_at=clock_timestamp()\n  WHERE q.id=ANY(request_ids) AND q.execution_closed_at IS NULL AND q.state=$12 AND q.billing_outcome=$13\n   AND EXISTS(SELECT $14 FROM public.attempts t WHERE t.id=q.selected_attempt_id AND t.request_id=q.id AND t.state=$15)\n   AND EXISTS(SELECT $16 FROM public.core_evidence_receipts r WHERE r.attempt_id=q.selected_attempt_id AND r.outcome=$17 AND r.attempt_state=$18 AND r.request_state=$19)\n  RETURNING q.id\n ) UPDATE public.execution_quota_leases l SET state=$20 WHERE l.request_id IN(SELECT id FROM closed) AND l.state IN($21,$22)",
