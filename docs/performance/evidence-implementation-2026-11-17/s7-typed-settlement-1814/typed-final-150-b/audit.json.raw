        "queryid": "2094837984682457506",
        "toplevel": false,
        "query": "SELECT ARRAY(\n  SELECT ROW(\n   t.id,t.request_id,q.project_id,v.currency,h,v.rates,coalesce(bp.rates,$2),bp.basis,\n   coalesce(rev.revision,$3),ci.id,coalesce(cp.usage,$4),coalesce(ci.final_dimensions,$5),\n   EXISTS(SELECT $6 FROM public.core_evidence_receipts r WHERE r.attempt_id=t.id AND r.outcome=$7 AND r.finality IN($8,$9)),\n   coalesce(src.sources,$10),t.state,t.finished_at,t.error_code,t.provider_request_id,$11,$12,$13,$14\n  )::core_funding.evidence_attempt_stage_v1\n  FROM public.attempts t\n  JOIN public.gateway_requests q ON q.id=t.request_id\n  JOIN public.upstream_holds h ON h.attempt_id=t.id\n  JOIN public.cost_versions v ON v.id=h.cost_version_id\n  LEFT JOIN public.billing_prices bp ON bp.id=t.billing_pricing_id\n  LEFT JOIN LATERAL (\n   SELECT max(i.snapshot_revision) revision FROM public.usage_event_index i WHERE i.attempt_id=t.id AND i.snapshot_revision IS NOT NULL\n  ) rev ON $15\n  LEFT JOIN LATERAL (\n   SELECT i.id,i.created_at,i.final_dimensions FROM public.usage_event_index i\n   WHERE i.attempt_id=t.id AND i.record_kind=$16 ORDER BY i.snapshot_revision DESC LIMIT $17\n  ) ci ON $18\n  LEFT JOIN public.usage_payloads cp ON cp.id=ci.id AND cp.created_at=ci.created_at\n  LEFT JOIN LATERAL (\n   SELECT jsonb_object_agg(jsonb_build_array(s.origin_identity,s.source)::text,s.revision) sources\n   FROM (\n    SELECT r.origin_identity,r.source,max(r.source_revision) revision FROM public.core_evidence_receipts r\n    WHERE r.attempt_id=t.id AND r.outcome=$19 GROUP BY r.origin_identity,r.source\n   ) s\n  ) src ON $20\n  WHERE t.id=ANY(ids)\n  ORDER BY t.id\n )",
        "calls": 4063,
        "total_exec_time": 6317.034377,
        "wal_bytes": 21526,
        "wal_records": 321
