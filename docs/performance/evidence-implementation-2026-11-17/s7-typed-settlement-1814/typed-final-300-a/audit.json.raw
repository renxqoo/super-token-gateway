        "query": "EXISTS(SELECT $56 FROM public.attempts t JOIN public.billing_holds bh ON bh.request_id=t.request_id JOIN public.wallets w ON w.id=bh.wallet_id WHERE t.id=ANY(attempt_ids) GROUP BY bh.wallet_id HAVING count(DISTINCT pending->$57->>t.id::text)>$58 OR bool_or(w.has_expiring_lots))\n   OR (SELECT count(*) FROM public.attempts t JOIN public.billing_holds bh ON bh.request_id=t.request_id WHERE t.id=ANY(attempt_ids))<>cardinality(attempt_ids)\n   OR EXISTS(SELECT $59 FROM generate_series($60,n) j WHERE mode[j]<>$61 OR contested[j] OR auth[j]<>$62)",
