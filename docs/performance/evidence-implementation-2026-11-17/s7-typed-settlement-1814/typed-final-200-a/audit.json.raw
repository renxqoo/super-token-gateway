        "queryid": "4099963231912186063",
        "toplevel": false,
        "query": "UPDATE public.execution_permits ep SET state=$2,granted_at=clock_timestamp()\n FROM jsonb_each(pending->$3) g JOIN public.api_keys k ON k.id=(g.value->>$4)::uuid\n WHERE ep.attempt_id=g.key::uuid AND ep.state=$5\n  AND (ep.owner_service,ep.gateway_instance_id,ep.owner_session_id,ep.owner_key_sha256,ep.certificate_sha256,ep.incarnation_id,ep.permit_epoch,ep.context_id,ep.authorization_plan_digest,ep.dispatched_digest,ep.prep_session_id,ep.prep_binding_digest)\n   IS NOT DISTINCT FROM ((g.value->$6->>$7),(g.value->$8->>$9),(g.value->$10->>$11)::uuid,(g.value->$12->>$13),(g.value->$14->>$15),(g.value->$16->>$17)::uuid,(g.value->$18->>$19)::numeric,(g.value->$20->>$21)::uuid,(g.value->$22->>$23),(g.value->$24->>$25),(g.value->$26->>$27)::uuid,(g.value->$28->>$29))\n  AND ep.expires_at>clock_timestamp() AND (g.value->>$30)::timestamptz>clock_timestamp()\n  AND (g.value->$31->>$32)::timestamptz>clock_timestamp()\n  AND (g.value->$33->>$34)::timestamptz<=clock_timestamp()\n  AND (g.value->$35->>$36)::timestamptz>clock_timestamp()\n  AND (k.expires_at IS NULL OR k.expires_at>clock_timestamp())\n  AND (g.value->>$37)::numeric-extract($38 FROM clock_timestamp())*$39>$40",
        "calls": 4677,
        "total_exec_time": 7526.820594000002,
        "wal_bytes": 37100123,
        "wal_records": 87922
      }
    ]
