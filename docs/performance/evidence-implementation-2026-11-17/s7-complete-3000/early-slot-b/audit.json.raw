        "query": "UPDATE public.upstream_holds h SET state=$2,current_reserved_atoms=$3,final_cost_atoms=s.cost_atoms\n FROM unnest(items) s WHERE h.attempt_id=(s.hold).attempt_id AND h.state=$4\n AND h.current_reserved_atoms=(s.hold).current_reserved_atoms",
