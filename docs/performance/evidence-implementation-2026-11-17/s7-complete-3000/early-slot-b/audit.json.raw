        "query": "SELECT $2||coalesce(string_agg(to_jsonb(key)::text||$3||CASE WHEN jsonb_typeof(value) IN ($4,$5) THEN public.core_canonical_v1(value) ELSE value::text END,$6 ORDER BY public.core_utf16_sort_v1(key)),$7)||$8        FROM jsonb_each(v)",
