        "queryid": "4945087430066604416",
        "toplevel": true,
        "query": "SELECT a.request_id FROM attempts a\n                      JOIN usage_event_index i ON i.attempt_id=a.id AND i.record_kind<>$3\n                      LEFT JOIN event_deliveries d ON d.consumer_id=$1  AND d.event_id=i.id\n                      WHERE a.request_id=ANY($2 ::uuid[]) GROUP BY a.request_id\n                      HAVING bool_and(d.state IS NOT DISTINCT FROM $4)",
