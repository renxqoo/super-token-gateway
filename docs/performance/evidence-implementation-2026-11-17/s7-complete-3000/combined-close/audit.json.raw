        "query": "SELECT coalesce(jsonb_agg(jsonb_build_object($4,$5,$6,r.kind,$7,r.artifact_digest) ORDER BY r.kind,r.artifact_digest),$8)              FROM (\n   SELECT $9::text kind,p.release_descriptor->>$10 artifact_digest FROM public.plugin_packages p WHERE p.digest=package AND p.release_descriptor->>$11 ~ $12\n   UNION\n   SELECT a.kind,a.artifact_digest FROM core_execution_runtime.approvals a WHERE a.package_digest=package AND a.active AND (a.facts->>$13)::timestamptz>clock_timestamp()\n  )r WHERE NOT EXISTS(SELECT $14 FROM core_execution_runtime.approvals a WHERE a.package_digest=package AND a.kind=r.kind AND a.artifact_digest=r.artifact_digest AND (NOT a.active OR (a.facts->>$15)::timestamptz<=clock_timestamp()))",
