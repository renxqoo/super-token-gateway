      },
      {
        "userid": "10",
        "queryid": "-1537567489184843343",
        "toplevel": false,
        "query": "INSERT INTO public.usage_event_index(id,project_id,request_id,attempt_id,source,finality,cost_atoms,currency,cost_complete,record_kind,snapshot_revision,snapshot_digest,final_dimensions,parent_evidence_id,input_fact_id)\n SELECT (f).id,(f).project_id,(f).request_id,(f).attempt_id,(f).source,(f).finality,(f).cost_atoms,\n  (f).currency,(f).cost_complete,(f).record_kind,(f).snapshot_revision,(f).snapshot_digest,\n  (f).final_dimensions,(f).parent_evidence_id,(f).input_fact_id\n FROM unnest(snapshots) s(f,usage) ORDER BY (f).attempt_id,(f).snapshot_revision",
        "calls": 4808,
        "total_exec_time": 9249.665024999995,
        "wal_bytes": 68299427,
        "wal_records": 499047
      },
      {
        "userid": "10",
        "queryid": "5459182685938901689",
        "toplevel": false,
        "query": "UPDATE core_funding.balance_cells c SET balance_atoms=n.balance_atoms,reserved_atoms=n.reserved_atoms,spent_atoms=n.spent_atoms,revision=n.revision\n FROM jsonb_each(pending->$2) e CROSS JOIN LATERAL jsonb_populate_record($3::core_funding.balance_cells,e.value->$4) b CROSS JOIN LATERAL jsonb_populate_record($5::core_funding.balance_cells,e.value->$6) n\n WHERE (c.account_id,c.currency,c.cell)=(b.account_id,b.currency,b.cell) AND (n.account_id,n.currency,n.cell)=(b.account_id,b.currency,b.cell)\n  AND (c.balance_atoms,c.reserved_atoms,c.spent_atoms,c.revision,c.spent_limit,c.revision_limit) IS NOT DISTINCT FROM (b.balance_atoms,b.reserved_atoms,b.spent_atoms,b.revision,b.spent_limit,b.revision_limit)\n  AND (n.spent_limit,n.revision_limit) IS NOT DISTINCT FROM (b.spent_limit,b.revision_limit)",
        "calls": 6147,
        "total_exec_time": 8550.213628999978,
        "wal_bytes": 1810657,
        "wal_records": 23585
      },
      {
        "userid": "10",
        "queryid": "-5597259185334725207",
        "toplevel": false,
        "query": "INSERT INTO public.execution_commands(id,command_id,kind,caller_identity,owner_session_id,caller_incarnation,body_digest,deadline_at,trace_id,contract_version,state,request_id,attempt_id,context_id,receipt)\n  SELECT id,command_id,kind,caller_identity,owner_session_id,caller_incarnation,body_digest,deadline_at,trace_id,contract_version,state,request_id,attempt_id,context_id,receipt FROM jsonb_to_recordset(pending->$2) x(id uuid,command_id uuid,kind text,caller_identity text,owner_session_id uuid,caller_incarnation uuid,body_digest text,deadline_at timestamptz,trace_id text,contract_version integer,state text,request_id uuid,attempt_id uuid,context_id uuid,receipt jsonb)",
        "calls": 5812,
        "total_exec_time": 8189.6508150000045,
        "wal_bytes": 56942860,
        "wal_records": 152888
      },
      {
        "userid": "10",
        "queryid": "-3387021527507244756",
        "toplevel": false,
        "query": "SELECT ARRAY(\n  SELECT ROW(\n   t.id,t.request_id,q.project_id,v.currency,h,v.rates,coalesce(bp.rates,$2),bp.basis,\n   coalesce(rev.revision,$3),ci.id,coalesce(cp.usage,$4),coalesce(ci.final_dimensions,$5),\n   EXISTS(SELECT $6 FROM public.core_evidence_receipts r WHERE r.attempt_id=t.id AND r.outcome=$7 AND r.finality IN($8,$9)),\n   coalesce(src.sources,$10),t.state,t.finished_at,t.error_code,t.provider_request_id,$11,$12,$13,$14\n  )::core_funding.evidence_attempt_stage_v1\n  FROM public.attempts t\n  JOIN public.gateway_requests q ON q.id=t.request_id\n  JOIN public.upstream_holds h ON h.attempt_id=t.id\n  JOIN public.cost_versions v ON v.id=h.cost_version_id\n  LEFT JOIN public.billing_prices bp ON bp.id=t.billing_pricing_id\n  LEFT JOIN LATERAL (\n   SELECT max(i.snapshot_revision) revision FROM public.usage_event_index i WHERE i.attempt_id=t.id AND i.snapshot_revision IS NOT NULL\n  ) rev ON $15\n  LEFT JOIN LATERAL (\n   SELECT i.id,i.created_at,i.final_dimensions FROM public.usage_event_index i\n   WHERE i.attempt_id=t.id AND i.record_kind=$16 ORDER BY i.snapshot_revision DESC LIMIT $17\n  ) ci ON $18\n  LEFT JOIN public.usage_payloads cp ON cp.id=ci.id AND cp.created_at=ci.created_at\n  LEFT JOIN LATERAL (\n   SELECT jsonb_object_agg(jsonb_build_array(s.origin_identity,s.source)::text,s.revision) sources\n   FROM (\n    SELECT r.origin_identity,r.source,max(r.source_revision) revision FROM public.core_evidence_receipts r\n    WHERE r.attempt_id=t.id AND r.outcome=$19 GROUP BY r.origin_identity,r.source\n   ) s\n  ) src ON $20\n  WHERE t.id=ANY(ids)\n  ORDER BY t.id\n )",
        "calls": 4808,
        "total_exec_time": 7480.03325499998,
        "wal_bytes": 19562,
        "wal_records": 279
      },
      {
        "userid": "10",
        "queryid": "3104701718891898966",
        "toplevel": false,
        "query": "SELECT $11 FROM public.execution_permits WHERE attempt_id=ANY(attempt_ids) ORDER BY attempt_id FOR NO KEY UPDATE NOWAIT",
        "calls": 8523,
        "total_exec_time": 7295.552975,
        "wal_bytes": 3498999,
        "wal_records": 30484
      },
      {
        "userid": "10",
        "queryid": "-243182412954754900",
        "toplevel": false,
        "query": "UPDATE public.execution_permits ep SET state=$2,granted_at=clock_timestamp()\n FROM jsonb_each(pending->$3) g JOIN public.api_keys k ON k.id=(g.value->>$4)::uuid\n WHERE ep.attempt_id=g.key::uuid AND ep.state=$5\n  AND (ep.owner_service,ep.gateway_instance_id,ep.owner_session_id,ep.owner_key_sha256,ep.certificate_sha256,ep.incarnation_id,ep.permit_epoch,ep.context_id,ep.authorization_plan_digest,ep.dispatched_digest,ep.prep_session_id,ep.prep_binding_digest)\n   IS NOT DISTINCT FROM ((g.value->$6->>$7),(g.value->$8->>$9),(g.value->$10->>$11)::uuid,(g.value->$12->>$13),(g.value->$14->>$15),(g.value->$16->>$17)::uuid,(g.value->$18->>$19)::numeric,(g.value->$20->>$21)::uuid,(g.value->$22->>$23),(g.value->$24->>$25),(g.value->$26->>$27)::uuid,(g.value->$28->>$29))\n  AND ep.expires_at>clock_timestamp() AND (g.value->>$30)::timestamptz>clock_timestamp()\n  AND (g.value->$31->>$32)::timestamptz>clock_timestamp()\n  AND (g.value->$33->>$34)::timestamptz<=clock_timestamp()\n  AND (g.value->$35->>$36)::timestamptz>clock_timestamp()\n  AND (k.expires_at IS NULL OR k.expires_at>clock_timestamp())\n  AND (g.value->>$37)::numeric-extract($38 FROM clock_timestamp())*$39>$40",
        "calls": 3126,
        "total_exec_time": 7018.414371000005,
        "wal_bytes": 39744054,
        "wal_records": 91396
      }
    ]
  },
