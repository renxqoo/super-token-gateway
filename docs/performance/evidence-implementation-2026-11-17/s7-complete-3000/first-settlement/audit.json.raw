        "query": "SELECT coalesce(jsonb_agg(jsonb_build_object('attempt_id',attempt_id,'descriptor',descriptor)),'[]'::jsonb)             FROM (SELECT attempt_id,descriptor FROM public.execution_quota_leases WHERE state='RELEASE_PENDING' ORDER BY lease_id LIMIT items::text::integer) pending",
