        "query": "WITH candidates AS MATERIALIZED (\n  SELECT n.id,n.selected_attempt_id,n.state,n.billing_outcome,n.updated_at,\n   q.execution_closed_at IS NULL AND n.state=$2 AND n.billing_outcome=$3\n   AND EXISTS(SELECT $4 FROM public.attempts t WHERE t.id=n.selected_attempt_id AND t.request_id=q.id AND t.state=$5)\n   AND EXISTS(SELECT $6 FROM public.core_evidence_receipts r WHERE r.attempt_id=n.selected_attempt_id AND r.outcome=$7 AND r.attempt_state=$8 AND r.request_state=$9) AS close\n  FROM jsonb_each(frame->$10) d CROSS JOIN LATERAL jsonb_populate_record($11::public.gateway_requests,frame->$12->d.key) n\n  JOIN public.gateway_requests q ON q.id=n.id\n ), changed AS (\n  UPDATE public.gateway_requests q SET selected_attempt_id=n.selected_attempt_id,state=n.state,billing_outcome=n.billing_outcome,updated_at=n.updated_at,\n   execution_closed_at=CASE WHEN n.close THEN clock_timestamp() ELSE q.execution_closed_at END\n  FROM candidates n WHERE q.id=n.id RETURNING q.id,n.close\n ), leases AS (\n  UPDATE public.execution_quota_leases l SET state=$13\n  WHERE l.request_id IN(SELECT id FROM changed WHERE close) AND l.state IN($14,$15)\n )\n SELECT count(*)              FROM changed",
