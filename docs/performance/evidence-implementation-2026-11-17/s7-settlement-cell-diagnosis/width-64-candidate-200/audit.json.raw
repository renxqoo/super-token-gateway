        "query": "UPDATE core_funding.balance_cells c SET balance_atoms=n.balance_atoms,reserved_atoms=n.reserved_atoms,spent_atoms=n.spent_atoms,revision=n.revision\n FROM jsonb_each(pending->$2) e CROSS JOIN LATERAL jsonb_populate_record($3::core_funding.balance_cells,e.value->$4) b CROSS JOIN LATERAL jsonb_populate_record($5::core_funding.balance_cells,e.value->$6) n\n WHERE (c.account_id,c.currency,c.cell)=(b.account_id,b.currency,b.cell) AND (n.account_id,n.currency,n.cell)=(b.account_id,b.currency,b.cell)\n  AND (c.balance_atoms,c.reserved_atoms,c.spent_atoms,c.revision,c.spent_limit,c.revision_limit) IS NOT DISTINCT FROM (b.balance_atoms,b.reserved_atoms,b.spent_atoms,b.revision,b.spent_limit,b.revision_limit)\n  AND (n.spent_limit,n.revision_limit) IS NOT DISTINCT FROM (b.spent_limit,b.revision_limit)",
        "calls": 10044,
        "total_exec_time": 7789.188582999987,
        "wal_bytes": 2036832,
        "wal_records": 27036
      },
      {
        "userid": "10",
        "queryid": "6200839296675382440",
        "toplevel": false,
        "query": "INSERT INTO public.execution_quota_leases(lease_id,attempt_id,command_id,scope_kind,scope_id,request_id,state,descriptor)\n  SELECT l.lease_id,l.attempt_id,l.command_id,l.scope_kind,l.scope_id,l.request_id,l.state,l.descriptor\n  FROM jsonb_each(pending->$2) a CROSS JOIN LATERAL jsonb_to_recordset(a.value->$3) l(lease_id text,attempt_id uuid,command_id uuid,scope_kind text,scope_id text,request_id uuid,state text,descriptor jsonb)",
        "calls": 5699,
        "total_exec_time": 7533.537952999999,
        "wal_bytes": 56114481,
        "wal_records": 169551
      },
      {
        "userid": "10",
        "queryid": "-4524182593233647194",
        "toplevel": false,
        "query": "EXISTS(SELECT $56 FROM public.attempts t JOIN public.billing_holds bh ON bh.request_id=t.request_id JOIN public.wallets w ON w.id=bh.wallet_id WHERE t.id=ANY(attempt_ids) GROUP BY bh.wallet_id HAVING count(DISTINCT pending->$57->>t.id::text)>$58 OR bool_or(w.has_expiring_lots))\n   OR (SELECT count(*) FROM public.attempts t JOIN public.billing_holds bh ON bh.request_id=t.request_id WHERE t.id=ANY(attempt_ids))<>cardinality(attempt_ids)\n   OR EXISTS(SELECT $59 FROM generate_series($60,n) j WHERE mode[j]<>$61 OR contested[j] OR auth[j]<>$62)",
        "calls": 4350,
        "total_exec_time": 7473.22054500001,
        "wal_bytes": 58750,
        "wal_records": 945
      },
      {
        "userid": "10",
        "queryid": "-5099875580241888652",
        "toplevel": false,
        "query": "INSERT INTO public.execution_commands(id,command_id,kind,caller_identity,owner_session_id,caller_incarnation,body_digest,deadline_at,trace_id,contract_version,state,request_id,attempt_id,context_id,receipt)\n  SELECT id,command_id,kind,caller_identity,owner_session_id,caller_incarnation,body_digest,deadline_at,trace_id,contract_version,state,request_id,attempt_id,context_id,receipt FROM jsonb_to_recordset(pending->$2) x(id uuid,command_id uuid,kind text,caller_identity text,owner_session_id uuid,caller_incarnation uuid,body_digest text,deadline_at timestamptz,trace_id text,contract_version integer,state text,request_id uuid,attempt_id uuid,context_id uuid,receipt jsonb)",
        "calls": 11160,
