      {
        "userid": "10",
        "queryid": "-6941033582605524412",
        "toplevel": false,
        "query": "SELECT DISTINCT h.wallet_id FROM billing_charges c JOIN billing_holds h ON h.id=c.hold_id\n  WHERE c.request_id=ANY(p_requests) AND c.debt_atoms>$3 AND (p_token IS NULL OR h.reconcile_token=p_token AND h.reconcile_until>clock_timestamp())\n  AND NOT EXISTS(SELECT $4 FROM attempts a WHERE a.request_id=c.request_id AND a.metering_conflict AND NOT EXISTS(SELECT $5 FROM billing_resolutions r WHERE r.request_id=c.request_id))\n  ORDER BY h.wallet_id",
        "calls": 4912,
