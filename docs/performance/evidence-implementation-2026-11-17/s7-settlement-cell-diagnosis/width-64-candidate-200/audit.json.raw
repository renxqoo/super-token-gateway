        "query": "SELECT EXISTS(\n  SELECT $3 FROM pg_catalog.pg_locks l\n  WHERE l.locktype=$4 AND l.pid=pg_backend_pid() AND l.database=(SELECT oid FROM pg_catalog.pg_database WHERE datname=current_database())\n   AND l.classid::bigint=((core_funding.account_key_v1(account)>>$5)&$6)\n   AND l.objid::bigint=(core_funding.account_key_v1(account)&$7) AND l.objsubid=$8 AND l.granted\n   AND (l.mode=$9 OR NOT exclusive AND l.mode=$10)\n )",
