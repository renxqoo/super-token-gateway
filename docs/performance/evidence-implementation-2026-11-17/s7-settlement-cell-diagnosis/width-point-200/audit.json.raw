        "queryid": "8398047471144831586",
        "toplevel": false,
        "query": "EXISTS(SELECT $56 FROM public.attempts t JOIN public.billing_holds bh ON bh.request_id=t.request_id JOIN public.wallets w ON w.id=bh.wallet_id WHERE t.id=ANY(attempt_ids) GROUP BY bh.wallet_id HAVING count(DISTINCT pending->$57->>t.id::text)>$58 OR bool_or(w.has_expiring_lots))\n   OR (SELECT count(*) FROM public.attempts t JOIN public.billing_holds bh ON bh.request_id=t.request_id WHERE t.id=ANY(attempt_ids))<>cardinality(attempt_ids)\n   OR EXISTS(SELECT $59 FROM generate_series($60,n) j WHERE mode[j]<>$61 OR contested[j] OR auth[j]<>$62)",
        "calls": 4472,
        "total_exec_time": 9059.085898999992,
        "wal_bytes": 89640,
        "wal_records": 1399
      },
      {
        "userid": "10",
        "queryid": "6379019485532287219",
        "toplevel": false,
        "query": "INSERT INTO public.usage_event_index(id,project_id,request_id,attempt_id,source,finality,cost_atoms,currency,cost_complete,record_kind,snapshot_revision,snapshot_digest,final_dimensions,parent_evidence_id,input_fact_id)\n  SELECT i.id,i.project_id,i.request_id,i.attempt_id,i.source,i.finality,i.cost_atoms,i.currency,i.cost_complete,i.record_kind,i.snapshot_revision,i.snapshot_digest,i.final_dimensions,i.parent_evidence_id,i.input_fact_id\n  FROM jsonb_array_elements(frame->$2) s CROSS JOIN LATERAL jsonb_populate_record($3::public.usage_event_index,s->$4) i ORDER BY i.attempt_id,i.snapshot_revision",
        "calls": 4892,
