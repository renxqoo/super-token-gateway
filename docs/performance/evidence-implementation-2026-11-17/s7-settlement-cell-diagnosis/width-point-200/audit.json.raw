        "query": "INSERT INTO public.execution_contexts(id,project_id,key_id,owner_session_id,operation,model,ip,fingerprint,snapshot,expires_at) VALUES(id,(auth->>$11)::uuid,k,(p->>$12)::uuid,input->>$13,input->>$14,input->>$15,input->>$16,snapshot,expiry)",
