SELECT 'core' AS classification,last_value::text count FROM core_funding.capacity_lock_core WHERE is_called UNION ALL SELECT 'settlement' AS classification,last_value::text count FROM core_funding.capacity_lock_settlement WHERE is_called UNION ALL SELECT 'blank' AS classification,last_value::text count FROM core_funding.capacity_lock_blank WHERE is_called UNION ALL SELECT 'other' AS classification,last_value::text count FROM core_funding.capacity_lock_other WHERE is_called