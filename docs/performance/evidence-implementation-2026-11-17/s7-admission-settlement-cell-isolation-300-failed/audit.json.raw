        "query": "INSERT INTO public.usage_event_index(id,project_id,request_id,attempt_id,source,finality,cost_atoms,currency,cost_complete,record_kind,snapshot_revision,snapshot_digest,final_dimensions,parent_evidence_id,input_fact_id)\n  SELECT i.id,i.project_id,i.request_id,i.attempt_id,i.source,i.finality,i.cost_atoms,i.currency,i.cost_complete,i.record_kind,i.snapshot_revision,i.snapshot_digest,i.final_dimensions,i.parent_evidence_id,i.input_fact_id\n  FROM jsonb_array_elements(frame->$2) s CROSS JOIN LATERAL jsonb_populate_record($3::public.usage_event_index,s->$4) i ORDER BY i.attempt_id,i.snapshot_revision",
