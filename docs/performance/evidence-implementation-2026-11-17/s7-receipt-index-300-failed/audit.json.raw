        "toplevel": false,
        "query": "SELECT jsonb_build_object($2,jsonb_object_agg(t.id::text,jsonb_build_object($3,jsonb_build_object($4,t.id,$5,t.request_id,$6,t.state,$7,t.finished_at,$8,t.error_code,$9,t.provider_request_id),$10,to_jsonb(h),$11,v.rates,$12,coalesce(bp.rates,$13),$14,bp.basis,$15,q.project_id,$16,q.id,$17,v.currency,$18,coalesce(rev.revision,$19),$20,to_jsonb(ci),$21,coalesce(cp.usage,$22),$23,EXISTS(SELECT $24 FROM public.core_evidence_receipts r WHERE r.attempt_id=t.id AND r.outcome=$25 AND r.finality IN($26,$27)),$28,coalesce(src.sources,$29))),$30,jsonb_object_agg(q.id::text,jsonb_build_object($31,q.id,$32,q.selected_attempt_id,$33,q.state,$34,q.billing_outcome)),$35,$36::jsonb,$37,$38::jsonb,$39,$40::jsonb,$41,$42::jsonb)\n            FROM public.attempts t JOIN public.gateway_requests q ON q.id=t.request_id JOIN public.upstream_holds h ON h.attempt_id=t.id JOIN public.cost_versions v ON v.id=h.cost_version_id\n LEFT JOIN public.billing_prices bp ON bp.id=t.billing_pricing_id\n LEFT JOIN LATERAL(SELECT max(i.snapshot_revision) revision FROM public.usage_event_index i WHERE i.attempt_id=t.id AND i.snapshot_revision IS NOT NULL) rev ON $43\n LEFT JOIN LATERAL(SELECT i.* FROM public.usage_event_index i WHERE i.attempt_id=t.id AND i.record_kind=$44 ORDER BY i.snapshot_revision DESC LIMIT $45) ci ON $46\n LEFT JOIN public.usage_payloads cp ON cp.id=ci.id AND cp.created_at=ci.created_at\n LEFT JOIN LATERAL(SELECT jsonb_object_agg(jsonb_build_array(s.origin_identity,s.source)::text,s.revision) sources FROM(SELECT r.origin_identity,r.source,max(r.source_revision) revision FROM public.core_evidence_receipts r WHERE r.attempt_id=t.id AND r.outcome=$47 GROUP BY r.origin_identity,r.source) s) src ON $48\n WHERE t.id=ANY(ids)",
