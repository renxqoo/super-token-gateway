        "query": "SELECT $5||coalesce(string_agg(to_jsonb(key)::text||$6||CASE WHEN jsonb_typeof(value) IN ($7,$8)\n   THEN public.core_canonical_v1(value) ELSE value::text END,$9\n   ORDER BY CASE WHEN ascii_keys THEN key END COLLATE \"C\",CASE WHEN NOT ascii_keys THEN public.core_utf16_sort_v1(key) END),$10)||$11\n               FROM jsonb_each(v)",
