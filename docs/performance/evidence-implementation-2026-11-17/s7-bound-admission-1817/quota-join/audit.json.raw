        "queryid": "7861284834632765866",
        "toplevel": false,
        "query": "WITH supplied AS MATERIALIZED (\n   SELECT j.value AS descriptor,j.value->>$13 AS id FROM jsonb_array_elements(items) j\n  ), locked AS MATERIALIZED (\n   SELECT lease.* FROM public.execution_quota_leases lease\n   WHERE lease.lease_id IN(SELECT id FROM supplied) ORDER BY lease.lease_id FOR NO KEY UPDATE NOWAIT\n  ), allowed AS MATERIALIZED (\n   SELECT s.id,s.descriptor FROM supplied s JOIN locked lease ON lease.lease_id=s.id\n   WHERE lease.attempt_id=attempt AND lease.state IN($14,$15)\n    AND NOT EXISTS(SELECT $16 FROM public.gateway_requests q WHERE q.id=lease.request_id AND q.execution_closed_at IS NOT NULL)\n    AND (lease.descriptor-ARRAY[$17,$18,$19,$20,$21,$22])=\n        (s.descriptor-ARRAY[$23,$24,$25,$26,$27,$28])\n    AND s.descriptor->>$29=$30 AND s.descriptor->>$31=lease.attempt_id::text\n    AND s.descriptor->>$32=permit.permit_epoch::text\n    AND (s.descriptor->>$33)::numeric>$34 AND (s.descriptor->>$35)::numeric>=lease.revision\n  )\n  UPDATE public.execution_quota_leases target SET state=action,revision=(a.descriptor->>$36)::numeric,descriptor=a.descriptor\n  FROM allowed a WHERE target.lease_id=a.id AND (SELECT count(DISTINCT id) FROM allowed)=jsonb_array_length(items)",
        "calls": 10980,
        "total_exec_time": 62406.665179000105,
        "wal_bytes": 60167037,
        "wal_records": 274277
