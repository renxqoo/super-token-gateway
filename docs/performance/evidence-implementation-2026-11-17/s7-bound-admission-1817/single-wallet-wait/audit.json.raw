        "queryid": "609505328764969453",
        "toplevel": false,
        "query": "WITH supplied AS MATERIALIZED (\n   SELECT j.value AS descriptor,j.value->>$13 AS id FROM jsonb_array_elements(items) j ORDER BY j.value->>'lease_id'\n  ), allowed AS MATERIALIZED (\n   SELECT s.id,s.descriptor,lease.row_id FROM supplied s\n   CROSS JOIN LATERAL (\n    SELECT q.ctid AS row_id,q.attempt_id,q.request_id,q.state,q.revision,q.descriptor\n    FROM public.execution_quota_leases q WHERE q.lease_id=s.id FOR NO KEY UPDATE NOWAIT\n   ) lease\n   WHERE lease.attempt_id=attempt AND lease.state IN($14,$15)\n    AND NOT EXISTS(SELECT $16 FROM public.gateway_requests q WHERE q.id=lease.request_id AND q.execution_closed_at IS NOT NULL)\n    AND (lease.descriptor-ARRAY[$17,$18,$19,$20,$21,$22])=\n        (s.descriptor-ARRAY[$23,$24,$25,$26,$27,$28])\n    AND s.descriptor->>$29=$30 AND s.descriptor->>$31=lease.attempt_id::text\n    AND s.descriptor->>$32=permit.permit_epoch::text\n    AND (s.descriptor->>$33)::numeric>$34 AND (s.descriptor->>$35)::numeric>=lease.revision\n  )\n  UPDATE public.execution_quota_leases target\n  SET (state,revision,descriptor)=(SELECT action,(a.descriptor->>$36)::numeric,a.descriptor FROM allowed a WHERE a.row_id=target.ctid)\n  WHERE target.ctid=ANY(ARRAY(SELECT row_id FROM allowed)) AND (SELECT count(DISTINCT id) FROM allowed)=jsonb_array_length(items)",
        "calls": 12053,
        "total_exec_time": 56312.42003199972,
