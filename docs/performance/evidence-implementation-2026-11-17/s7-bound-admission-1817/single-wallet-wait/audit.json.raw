      },
      {
        "userid": "10",
        "queryid": "1445099856590082489",
        "toplevel": false,
        "query": "UPDATE core_funding.balance_cells c SET balance_atoms=n.balance_atoms,reserved_atoms=n.reserved_atoms,spent_atoms=n.spent_atoms,revision=n.revision\n FROM jsonb_each(pending->$2) e CROSS JOIN LATERAL jsonb_populate_record($3::core_funding.balance_cells,e.value->$4) b CROSS JOIN LATERAL jsonb_populate_record($5::core_funding.balance_cells,e.value->$6) n\n WHERE (c.account_id,c.currency,c.cell)=(b.account_id,b.currency,b.cell) AND (n.account_id,n.currency,n.cell)=(b.account_id,b.currency,b.cell)\n  AND (c.balance_atoms,c.reserved_atoms,c.spent_atoms,c.revision,c.spent_limit,c.revision_limit) IS NOT DISTINCT FROM (b.balance_atoms,b.reserved_atoms,b.spent_atoms,b.revision,b.spent_limit,b.revision_limit)\n  AND (n.spent_limit,n.revision_limit) IS NOT DISTINCT FROM (b.spent_limit,b.revision_limit)",
        "calls": 8299,
        "total_exec_time": 6899.132181000013,
        "wal_bytes": 2142169,
        "wal_records": 28290
      },
      {
        "userid": "10",
        "queryid": "8776207652427760800",
        "toplevel": false,
        "query": "INSERT INTO public.core_evidence_receipts(id,origin_identity,origin_incarnation,origin_session_id,event_id,attempt_id,source,source_revision,body_digest,event_claim,revision_claim,outcome,finality,attempt_state,request_state,error_code,provider_request_id,raw_evidence_id,canonical_evidence_id,disputed_evidence_id,conflict_id,risk_dimensions,numeric_fault,authentication_disposition,authentication_reason,producer_key_sha256,signature_version,signature,signature_payload_digest)\n SELECT r.id,r.origin_identity,r.origin_incarnation,r.origin_session_id,r.event_id,r.attempt_id,r.source,r.source_revision,\n  r.body_digest,r.event_claim,r.revision_claim,r.outcome,r.finality,r.attempt_state,r.request_state,r.error_code,\n  r.provider_request_id,r.raw_evidence_id,r.canonical_evidence_id,r.disputed_evidence_id,r.conflict_id,r.risk_dimensions,\n  r.numeric_fault,r.authentication_disposition,r.authentication_reason,r.producer_key_sha256,r.signature_version,\n  r.signature,r.signature_payload_digest\n FROM unnest(receipts) r",
        "calls": 4868,
        "total_exec_time": 6753.9619249999905,
        "wal_bytes": 36182983,
        "wal_records": 146036
      }
