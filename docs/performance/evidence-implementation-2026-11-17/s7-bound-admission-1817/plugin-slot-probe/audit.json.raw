      {
        "userid": "10",
        "queryid": "1094268097684197205",
        "toplevel": false,
        "query": "WITH targets AS MATERIALIZED (\n   SELECT n.*,q.execution_closed_at FROM unnest(requests) n JOIN public.gateway_requests q ON q.id=n.id\n  ), updated AS (\n   UPDATE public.gateway_requests q SET selected_attempt_id=n.selected_attempt_id,state=n.state,billing_outcome=n.billing_outcome,\n    updated_at=n.updated_at,execution_closed_at=coalesce(n.execution_closed_at,clock_timestamp())\n   FROM targets n WHERE q.id=n.id RETURNING q.id,n.execution_closed_at IS NULL AS closed\n  ), released AS (\n   UPDATE public.execution_quota_leases SET state=$63 WHERE request_id IN(SELECT id FROM updated WHERE closed) AND state IN($64,$65)\n  ) SELECT count(*)                   FROM updated",
        "calls": 5182,
        "total_exec_time": 19048.789271999998,
        "wal_bytes": 72430514,
        "wal_records": 338743
      },
      {
        "userid": "10",
        "queryid": "3540024235240138711",
        "toplevel": false,
        "query": "SELECT $5||coalesce(string_agg(to_jsonb(key)::text||$6||CASE WHEN jsonb_typeof(value) IN ($7,$8)\n   THEN public.core_canonical_v1(value) ELSE value::text END,$9\n   ORDER BY CASE WHEN ascii_keys THEN key END COLLATE \"C\",CASE WHEN NOT ascii_keys THEN public.core_utf16_sort_v1(key) END),$10)||$11\n               FROM jsonb_each(v)",
        "calls": 717986,
        "total_exec_time": 15079.88252599879,
        "wal_bytes": 0,
        "wal_records": 0
      },
      {
