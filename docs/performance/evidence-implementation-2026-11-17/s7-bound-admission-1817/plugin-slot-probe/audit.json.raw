        "toplevel": false,
        "query": "first_final=NOT EXISTS(SELECT $62 FROM unnest(events) e WHERE e->>$63<>$64 OR e->>$65<>$66)\n   AND NOT EXISTS(SELECT $67 FROM unnest(stages) st JOIN public.upstream_accounts ac ON ac.id=(st.hold).account_id\n     WHERE st.revision<>$68 OR (st.hold).state<>$69 OR ac.state<>$70)\n   AND NOT EXISTS(SELECT $71 FROM public.upstream_costs c WHERE c.attempt_id=ANY(attempt_ids))\n   AND NOT EXISTS(SELECT $72 FROM public.core_evidence_receipts r WHERE r.attempt_id=ANY(attempt_ids))",
        "calls": 5182,
