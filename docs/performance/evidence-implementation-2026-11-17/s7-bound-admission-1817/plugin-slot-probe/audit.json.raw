        "wal_records": 229635
      },
      {
        "userid": "10",
        "queryid": "2451647685712615251",
        "toplevel": false,
        "query": "SELECT public.internal_identity_current_v1(p||jsonb_build_object($2,$3,$4,$5))",
        "calls": 90962,
        "total_exec_time": 8977.745912999926,
        "wal_bytes": 15641067,
        "wal_records": 256836
      },
      {
        "userid": "10",
        "queryid": "4974690042572314028",
        "toplevel": false,
        "query": "WITH facts AS MATERIALIZED (\n  SELECT (f).id,(f).attempt_id,(f).request_id,(f).source,(f).finality,x.usage\n  FROM unnest(snapshots) x(f,usage) WHERE (f).record_kind=$3\n ), targets AS MATERIALIZED (\n  SELECT h.* FROM billing_holds h WHERE h.request_id=ANY(p_requests)\n ), candidates AS MATERIALIZED (\n  SELECT h.id AS hold_id,h.request_id,h.wallet_id,h.amount_atoms AS held,w.currency,\n   l.id AS lot_id,p.id AS pricing_id,e.id AS evidence_id,exact_billing_price(CASE p.basis WHEN $4 THEN $5::jsonb ELSE e.usage END,p.rates) AS actual\n  FROM targets h JOIN wallets w ON w.id=h.wallet_id\n  JOIN LATERAL(SELECT id,selected_attempt_id,operation,billing_outcome FROM gateway_requests WHERE id=h.request_id OFFSET $6) q ON $7\n  JOIN LATERAL(SELECT id,evidence_id,billing_pricing_id,state FROM attempts WHERE id=q.selected_attempt_id OFFSET $8) a ON $9\n  JOIN facts e ON (e.id,e.attempt_id,e.request_id)=(a.evidence_id,a.id,q.id)\n  JOIN billing_prices p ON p.id=a.billing_pricing_id\n  JOIN LATERAL(SELECT * FROM hold_allocations WHERE hold_id=h.id AND ordinal=$10 AND amount_atoms=h.amount_atoms OFFSET $11) s ON $12\n  JOIN wallet_lots l ON l.id=s.lot_id AND l.wallet_id=w.id AND l.expires_at IS NULL\n  WHERE h.state IN ($13,$14) AND h.credit_atoms=$15 AND w.debt_atoms=$16 AND w.freeze_reason IS NULL AND NOT w.evidence_disputed\n   AND q.operation IN ($17,$18,$19,$20,$21) AND q.billing_outcome=$22\n   AND a.state=$23 AND e.source=$24 AND e.finality=$25 AND p.basis IN ($26,$27) AND NOT w.has_expiring_lots AND p.currency=w.currency\n   AND (p.basis=$28 OR NOT EXISTS(SELECT $29 FROM jsonb_object_keys(p.rates) dimension WHERE NOT e.usage?dimension))\n   AND NOT EXISTS(SELECT $30 FROM hold_allocations extra WHERE extra.hold_id=h.id AND extra.ordinal<>$31)\n   AND NOT EXISTS(SELECT $32 FROM attempts x WHERE x.request_id=q.id AND x.metering_conflict)\n   AND NOT EXISTS(SELECT $33 FROM billing_resolutions x WHERE x.request_id=q.id)\n   AND NOT EXISTS(SELECT $34 FROM billing_charges x WHERE x.request_id=q.id)\n ), wallet_counts AS (\n  SELECT wallet_id,count(*) AS requests FROM targets GROUP BY wallet_id\n ), covered AS (\n  SELECT c.wallet_id FROM candidates c JOIN wallet_counts t ON t.wallet_id=c.wallet_id\n  WHERE c.actual>$35 AND c.actual<=c.held GROUP BY c.wallet_id,t.requests HAVING count(*)=t.requests\n ), entries AS MATERIALIZED (\n  SELECT c.*,ledger_uuid() AS charge_id,ledger_uuid() AS journal_id FROM (\n   SELECT candidate.* FROM candidates candidate JOIN covered w ON w.wallet_id=candidate.wallet_id\n   ORDER BY array_position(p_requests,candidate.request_id) OFFSET $36\n  ) c\n ), charges AS (\n  INSERT INTO billing_charges(id,request_id,hold_id,pricing_id,evidence_id,currency,amount_atoms,funded_atoms,debt_atoms)\n  SELECT charge_id,request_id,hold_id,pricing_id,evidence_id,currency,actual,actual,$37 FROM entries RETURNING id\n ), allocations AS (\n  INSERT INTO charge_allocations(charge_id,lot_id,ordinal,amount_atoms)\n  SELECT c.id,e.lot_id,$38,e.actual FROM entries e JOIN charges c ON c.id=e.charge_id\n ), lot_totals AS (\n  SELECT lot_id,sum(held) AS held,sum(actual) AS actual FROM entries GROUP BY lot_id\n ), lots AS (\n  UPDATE wallet_lots l SET reserved_atoms=l.reserved_atoms-t.held,available_atoms=l.available_atoms+t.held-t.actual,spent_atoms=l.spent_atoms+t.actual\n  FROM lot_totals t WHERE l.id=t.lot_id\n ), wallet_totals AS (\n  SELECT wallet_id,sum(held) AS held,sum(actual) AS actual FROM entries GROUP BY wallet_id\n ), balances AS (\n  UPDATE wallets w SET reserved_atoms=w.reserved_atoms-t.held,available_atoms=w.available_atoms+t.held-t.actual,spent_atoms=w.spent_atoms+t.actual\n  FROM wallet_totals t WHERE w.id=t.wallet_id\n ), holds AS (\n  UPDATE billing_holds h SET state=$39,closed_at=now(),next_reconcile_at=now()+interval $40,reconcile_until=$41,reconcile_reason=$42\n  FROM entries e WHERE h.id=e.hold_id\n )\n SELECT coalesce(jsonb_object_agg(e.request_id,jsonb_build_object($43,$44,$45,e.charge_id,$46,e.actual::text,$47,e.actual::text,$48,$49,$50,$51)),$52::jsonb),\n  coalesce(jsonb_agg(jsonb_build_object($53,e.journal_id,$54,e.wallet_id,$55,$56||e.request_id,$57,$58,$59,e.currency,$60,\n   jsonb_build_array(money_leg($61||e.lot_id||$62,-e.held))||\n   CASE WHEN e.held>e.actual THEN jsonb_build_array(money_leg($63||e.lot_id||$64,e.held-e.actual)) ELSE $65::jsonb END||\n   jsonb_build_array(money_leg($66,e.actual))) ORDER BY array_position(p_requests,e.request_id)),$67::jsonb)\n                        FROM entries e",
        "calls": 5182,
        "total_exec_time": 8631.649374,
        "wal_bytes": 20433447,
        "wal_records": 216130
      },
      {
        "userid": "10",
        "queryid": "-8835995643012767247",
        "toplevel": false,
        "query": "UPDATE public.execution_permits ep SET state=$2,granted_at=clock_timestamp()\n FROM jsonb_each(pending->$3) g JOIN public.api_keys k ON k.id=(g.value->>$4)::uuid\n WHERE ep.attempt_id=g.key::uuid AND ep.state=$5\n  AND (ep.owner_service,ep.gateway_instance_id,ep.owner_session_id,ep.owner_key_sha256,ep.certificate_sha256,ep.incarnation_id,ep.permit_epoch,ep.context_id,ep.authorization_plan_digest,ep.dispatched_digest,ep.prep_session_id,ep.prep_binding_digest)\n   IS NOT DISTINCT FROM ((g.value->$6->>$7),(g.value->$8->>$9),(g.value->$10->>$11)::uuid,(g.value->$12->>$13),(g.value->$14->>$15),(g.value->$16->>$17)::uuid,(g.value->$18->>$19)::numeric,(g.value->$20->>$21)::uuid,(g.value->$22->>$23),(g.value->$24->>$25),(g.value->$26->>$27)::uuid,(g.value->$28->>$29))\n  AND ep.expires_at>clock_timestamp() AND (g.value->>$30)::timestamptz>clock_timestamp()\n  AND (g.value->$31->>$32)::timestamptz>clock_timestamp()\n  AND (g.value->$33->>$34)::timestamptz<=clock_timestamp()\n  AND (g.value->$35->>$36)::timestamptz>clock_timestamp()\n  AND (k.expires_at IS NULL OR k.expires_at>clock_timestamp())\n  AND (g.value->>$37)::numeric-extract($38 FROM clock_timestamp())*$39>$40",
        "calls": 4114,
        "total_exec_time": 8235.676474999982,
        "wal_bytes": 42892967,
        "wal_records": 98857
      },
      {
        "userid": "10",
        "queryid": "-4083862105205473861",
        "toplevel": false,
        "query": "INSERT INTO public.execution_quota_leases(lease_id,attempt_id,command_id,scope_kind,scope_id,request_id,state,descriptor)\n  SELECT l.lease_id,l.attempt_id,l.command_id,l.scope_kind,l.scope_id,l.request_id,l.state,l.descriptor\n  FROM jsonb_each(pending->$2) a CROSS JOIN LATERAL jsonb_to_recordset(a.value->$3) l(lease_id text,attempt_id uuid,command_id uuid,scope_kind text,scope_id text,request_id uuid,state text,descriptor jsonb)",
