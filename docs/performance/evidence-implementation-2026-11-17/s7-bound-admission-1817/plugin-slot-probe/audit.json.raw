        "queryid": "1118686191586925779",
        "toplevel": false,
        "query": "INSERT INTO public.usage_event_index(id,project_id,request_id,attempt_id,source,finality,cost_atoms,currency,cost_complete,record_kind,snapshot_revision,snapshot_digest,final_dimensions,parent_evidence_id,input_fact_id)\n SELECT (f).id,(f).project_id,(f).request_id,(f).attempt_id,(f).source,(f).finality,(f).cost_atoms,\n  (f).currency,(f).cost_complete,(f).record_kind,(f).snapshot_revision,(f).snapshot_digest,\n  (f).final_dimensions,(f).parent_evidence_id,(f).input_fact_id\n FROM unnest(snapshots) s(f,usage) ORDER BY (f).attempt_id,(f).snapshot_revision",
        "calls": 5182,
        "total_exec_time": 9721.14359,
        "wal_bytes": 75424756,
        "wal_records": 547940
      },
      {
        "userid": "10",
        "queryid": "6813178380239543005",
        "toplevel": true,
        "query": "SELECT a.request_id FROM attempts a\n                      JOIN usage_event_index i ON i.attempt_id=a.id AND i.record_kind<>$3\n                      LEFT JOIN event_deliveries d ON d.consumer_id=$1  AND d.event_id=i.id\n                      WHERE a.request_id=ANY($2 ::uuid[]) GROUP BY a.request_id\n                      HAVING bool_and(d.state IS NOT DISTINCT FROM $4)",
        "calls": 3262,
        "total_exec_time": 9289.154690999996,
        "wal_bytes": 52714,
        "wal_records": 673
      },
      {
        "userid": "10",
        "queryid": "2888936459750033634",
