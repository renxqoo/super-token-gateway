      },
      {
        "userid": "10",
        "queryid": "-4083862105205473861",
        "toplevel": false,
        "query": "INSERT INTO public.execution_quota_leases(lease_id,attempt_id,command_id,scope_kind,scope_id,request_id,state,descriptor)\n  SELECT l.lease_id,l.attempt_id,l.command_id,l.scope_kind,l.scope_id,l.request_id,l.state,l.descriptor\n  FROM jsonb_each(pending->$2) a CROSS JOIN LATERAL jsonb_to_recordset(a.value->$3) l(lease_id text,attempt_id uuid,command_id uuid,scope_kind text,scope_id text,request_id uuid,state text,descriptor jsonb)",
        "calls": 3560,
        "total_exec_time": 8167.167458000001,
        "wal_bytes": 75509409,
        "wal_records": 228903
      },
      {
        "userid": "10",
        "queryid": "-8835995643012767247",
        "toplevel": false,
        "query": "UPDATE public.execution_permits ep SET state=$2,granted_at=clock_timestamp()\n FROM jsonb_each(pending->$3) g JOIN public.api_keys k ON k.id=(g.value->>$4)::uuid\n WHERE ep.attempt_id=g.key::uuid AND ep.state=$5\n  AND (ep.owner_service,ep.gateway_instance_id,ep.owner_session_id,ep.owner_key_sha256,ep.certificate_sha256,ep.incarnation_id,ep.permit_epoch,ep.context_id,ep.authorization_plan_digest,ep.dispatched_digest,ep.prep_session_id,ep.prep_binding_digest)\n   IS NOT DISTINCT FROM ((g.value->$6->>$7),(g.value->$8->>$9),(g.value->$10->>$11)::uuid,(g.value->$12->>$13),(g.value->$14->>$15),(g.value->$16->>$17)::uuid,(g.value->$18->>$19)::numeric,(g.value->$20->>$21)::uuid,(g.value->$22->>$23),(g.value->$24->>$25),(g.value->$26->>$27)::uuid,(g.value->$28->>$29))\n  AND ep.expires_at>clock_timestamp() AND (g.value->>$30)::timestamptz>clock_timestamp()\n  AND (g.value->$31->>$32)::timestamptz>clock_timestamp()\n  AND (g.value->$33->>$34)::timestamptz<=clock_timestamp()\n  AND (g.value->$35->>$36)::timestamptz>clock_timestamp()\n  AND (k.expires_at IS NULL OR k.expires_at>clock_timestamp())\n  AND (g.value->>$37)::numeric-extract($38 FROM clock_timestamp())*$39>$40",
        "calls": 4130,
        "total_exec_time": 8130.561681999998,
        "wal_bytes": 43112026,
        "wal_records": 99743
      },
      {
        "userid": "10",
        "queryid": "-3499243416753020654",
        "toplevel": false,
        "query": "first_final=NOT EXISTS(SELECT $62 FROM unnest(events) e WHERE e->>$63<>$64 OR e->>$65<>$66)\n   AND NOT EXISTS(SELECT $67 FROM unnest(stages) st JOIN public.upstream_accounts ac ON ac.id=(st.hold).account_id\n     WHERE st.revision<>$68 OR (st.hold).state<>$69 OR ac.state<>$70)\n   AND NOT EXISTS(SELECT $71 FROM public.upstream_costs c WHERE c.attempt_id=ANY(attempt_ids))\n   AND NOT EXISTS(SELECT $72 FROM public.core_evidence_receipts r WHERE r.attempt_id=ANY(attempt_ids))",
        "calls": 4982,
        "total_exec_time": 8121.3516770000015,
        "wal_bytes": 0,
        "wal_records": 0
      },
      {
        "userid": "10",
        "queryid": "1445099856590082489",
        "toplevel": false,
        "query": "UPDATE core_funding.balance_cells c SET balance_atoms=n.balance_atoms,reserved_atoms=n.reserved_atoms,spent_atoms=n.spent_atoms,revision=n.revision\n FROM jsonb_each(pending->$2) e CROSS JOIN LATERAL jsonb_populate_record($3::core_funding.balance_cells,e.value->$4) b CROSS JOIN LATERAL jsonb_populate_record($5::core_funding.balance_cells,e.value->$6) n\n WHERE (c.account_id,c.currency,c.cell)=(b.account_id,b.currency,b.cell) AND (n.account_id,n.currency,n.cell)=(b.account_id,b.currency,b.cell)\n  AND (c.balance_atoms,c.reserved_atoms,c.spent_atoms,c.revision,c.spent_limit,c.revision_limit) IS NOT DISTINCT FROM (b.balance_atoms,b.reserved_atoms,b.spent_atoms,b.revision,b.spent_limit,b.revision_limit)\n  AND (n.spent_limit,n.revision_limit) IS NOT DISTINCT FROM (b.spent_limit,b.revision_limit)",
        "calls": 8192,
        "total_exec_time": 7147.9857860000075,
        "wal_bytes": 2230605,
        "wal_records": 29393
      },
      {
        "userid": "10",
        "queryid": "-5704610457540334448",
        "toplevel": false,
        "query": "UPDATE public.upstream_holds h SET state=$2,current_reserved_atoms=$3,final_cost_atoms=s.cost_atoms\n FROM unnest(items) s WHERE h.attempt_id=(s.hold).attempt_id AND h.state=$4\n AND h.current_reserved_atoms=(s.hold).current_reserved_atoms",
        "calls": 4982,
        "total_exec_time": 6987.06659500001,
        "wal_bytes": 10091540,
        "wal_records": 61667
      },
      {
        "userid": "10",
        "queryid": "-9024516533284970975",
        "toplevel": false,
        "query": "WITH journals AS MATERIALIZED (\n  SELECT * FROM jsonb_to_recordset(p_items) j(id uuid,wallet_id uuid,reference text,kind text,currency text,lines jsonb)\n ), entries AS (\n  INSERT INTO money_entries(id,wallet_id,reference,kind,currency)\n  SELECT j.id,j.wallet_id,j.reference,j.kind,j.currency FROM journals j\n  RETURNING id,created_at\n )\n INSERT INTO journal_payloads(id,created_at,lines)\n SELECT j.id,e.created_at,j.lines FROM journals j JOIN entries e ON e.id=j.id",
        "calls": 9225,
        "total_exec_time": 6600.927046999989,
        "wal_bytes": 34813685,
        "wal_records": 249282
      }
    ]
