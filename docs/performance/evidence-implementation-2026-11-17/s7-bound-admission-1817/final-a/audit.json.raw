        "query": "UPDATE public.execution_quota_leases lease SET state=action,revision=(adopted->lease.lease_id->>$12)::numeric,descriptor=adopted->lease.lease_id\n  WHERE lease.lease_id=ANY(ids)",
        "calls": 13675,
        "total_exec_time": 15827.221040000042,
