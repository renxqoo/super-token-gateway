        "query": "WITH existing AS MATERIALIZED (SELECT core_lookup_v1($1 ::jsonb,$2 ::jsonb) receipt)\n          SELECT receipt,CASE WHEN receipt IS NULL THEN core_preflight_v1($3 ::jsonb,$5,$4 ::uuid) END leases FROM existing",
