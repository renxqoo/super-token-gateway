      {
        "userid": "10",
        "queryid": "6601674134852956983",
        "toplevel": false,
        "query": "WITH facts AS MATERIALIZED (\n  SELECT (f).id,(f).attempt_id,(f).request_id,(f).source,(f).finality,x.usage\n  FROM unnest(snapshots) x(f,usage) WHERE (f).record_kind=$3\n ), targets AS MATERIALIZED (\n  SELECT h.* FROM billing_holds h WHERE h.request_id=ANY(p_requests)\n ), candidates AS MATERIALIZED (\n  SELECT h.id AS hold_id,h.request_id,h.wallet_id,h.amount_atoms AS held,w.currency,\n   l.id AS lot_id,p.id AS pricing_id,e.id AS evidence_id,exact_billing_price(CASE p.basis WHEN $4 THEN $5::jsonb ELSE e.usage END,p.rates) AS actual\n  FROM targets h JOIN wallets w ON w.id=h.wallet_id\n  JOIN LATERAL(SELECT id,selected_attempt_id,operation,billing_outcome FROM gateway_requests WHERE id=h.request_id OFFSET $6) q ON $7\n  JOIN LATERAL(SELECT id,evidence_id,billing_pricing_id,state FROM attempts WHERE id=q.selected_attempt_id OFFSET $8) a ON $9\n  JOIN facts e ON (e.id,e.attempt_id,e.request_id)=(a.evidence_id,a.id,q.id)\n  JOIN billing_prices p ON p.id=a.billing_pricing_id\n  JOIN LATERAL(SELECT * FROM hold_allocations WHERE hold_id=h.id AND ordinal=$10 AND amount_atoms=h.amount_atoms OFFSET $11) s ON $12\n  JOIN wallet_lots l ON l.id=s.lot_id AND l.wallet_id=w.id AND l.expires_at IS NULL\n  WHERE h.state IN ($13,$14) AND h.credit_atoms=$15 AND w.debt_atoms=$16 AND w.freeze_reason IS NULL AND NOT w.evidence_disputed\n   AND q.operation IN ($17,$18,$19,$20,$21) AND q.billing_outcome=$22\n   AND a.state=$23 AND e.source=$24 AND e.finality=$25 AND p.basis IN ($26,$27) AND NOT w.has_expiring_lots AND p.currency=w.currency\n   AND (p.basis=$28 OR NOT EXISTS(SELECT $29 FROM jsonb_object_keys(p.rates) dimension WHERE NOT e.usage?dimension))\n   AND NOT EXISTS(SELECT $30 FROM hold_allocations extra WHERE extra.hold_id=h.id AND extra.ordinal<>$31)\n   AND NOT EXISTS(SELECT $32 FROM attempts x WHERE x.request_id=q.id AND x.metering_conflict)\n   AND NOT EXISTS(SELECT $33 FROM billing_resolutions x WHERE x.request_id=q.id)\n   AND NOT EXISTS(SELECT $34 FROM billing_charges x WHERE x.request_id=q.id)\n ), wallet_counts AS (\n  SELECT wallet_id,count(*) AS requests FROM targets GROUP BY wallet_id\n ), covered AS (\n  SELECT c.wallet_id FROM candidates c JOIN wallet_counts t ON t.wallet_id=c.wallet_id\n  WHERE c.actual>$35 AND c.actual<=c.held GROUP BY c.wallet_id,t.requests HAVING count(*)=t.requests\n ), entries AS MATERIALIZED (\n  SELECT c.*,ledger_uuid() AS charge_id,ledger_uuid() AS journal_id FROM candidates c JOIN covered w ON w.wallet_id=c.wallet_id\n ), charges AS (\n  INSERT INTO billing_charges(id,request_id,hold_id,pricing_id,evidence_id,currency,amount_atoms,funded_atoms,debt_atoms)\n  SELECT charge_id,request_id,hold_id,pricing_id,evidence_id,currency,actual,actual,$36 FROM entries RETURNING id\n ), allocations AS (\n  INSERT INTO charge_allocations(charge_id,lot_id,ordinal,amount_atoms)\n  SELECT c.id,e.lot_id,$37,e.actual FROM entries e JOIN charges c ON c.id=e.charge_id\n ), lot_totals AS (\n  SELECT lot_id,sum(held) AS held,sum(actual) AS actual FROM entries GROUP BY lot_id\n ), lots AS (\n  UPDATE wallet_lots l SET reserved_atoms=l.reserved_atoms-t.held,available_atoms=l.available_atoms+t.held-t.actual,spent_atoms=l.spent_atoms+t.actual\n  FROM lot_totals t WHERE l.id=t.lot_id\n ), wallet_totals AS (\n  SELECT wallet_id,sum(held) AS held,sum(actual) AS actual FROM entries GROUP BY wallet_id\n ), balances AS (\n  UPDATE wallets w SET reserved_atoms=w.reserved_atoms-t.held,available_atoms=w.available_atoms+t.held-t.actual,spent_atoms=w.spent_atoms+t.actual\n  FROM wallet_totals t WHERE w.id=t.wallet_id\n ), holds AS (\n  UPDATE billing_holds h SET state=$38,closed_at=now(),next_reconcile_at=now()+interval $39,reconcile_until=$40,reconcile_reason=$41\n  FROM entries e WHERE h.id=e.hold_id\n )\n SELECT coalesce(jsonb_object_agg(e.request_id,jsonb_build_object($42,$43,$44,e.charge_id,$45,e.actual::text,$46,e.actual::text,$47,$48,$49,$50)),$51::jsonb),\n  coalesce(jsonb_agg(jsonb_build_object($52,e.journal_id,$53,e.wallet_id,$54,$55||e.request_id,$56,$57,$58,e.currency,$59,\n   jsonb_build_array(money_leg($60||e.lot_id||$61,-e.held))||\n   CASE WHEN e.held>e.actual THEN jsonb_build_array(money_leg($62||e.lot_id||$63,e.held-e.actual)) ELSE $64::jsonb END||\n   jsonb_build_array(money_leg($65,e.actual)))),$66::jsonb)\n                        FROM entries e",
        "calls": 5740,
