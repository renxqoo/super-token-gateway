        "toplevel": false,
        "query": "SELECT state.*        FROM core_funding.balance_cells state\n WHERE state.account_id=account AND state.currency=cur\n  AND state.balance_atoms-coalesce((pending->$11->(state.account_id::text||$12||state.currency||$13||state.cell::text)->$14->>$15)::numeric,state.reserved_atoms)>=amount\n  AND coalesce((pending->$16->(state.account_id::text||$17||state.currency||$18||state.cell::text)->$19->>$20)::numeric,state.revision)<state.revision_limit\n ORDER BY (state.cell-preferred+$21)%$22 LIMIT $23 FOR NO KEY UPDATE OF state SKIP LOCKED",
