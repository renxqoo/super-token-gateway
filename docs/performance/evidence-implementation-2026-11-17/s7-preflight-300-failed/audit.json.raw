        "query": "EXISTS(SELECT $6 FROM public.attempts t JOIN public.billing_holds h ON h.request_id=t.request_id JOIN public.wallets w ON w.id=h.wallet_id WHERE attempt_owners?t.id::text GROUP BY h.wallet_id HAVING count(DISTINCT attempt_owners->>t.id::text)>$7 OR bool_or(w.has_expiring_lots))",
        "calls": 4085,
