        "query": "cache=core_funding.customer_authorities_v1((SELECT coalesce(jsonb_agg(value),$6) FROM jsonb_array_elements(items) WITH ORDINALITY i(value,n) WHERE item_errors[n] IS NULL AND group_errors[group_indices[n]] IS NULL))",
