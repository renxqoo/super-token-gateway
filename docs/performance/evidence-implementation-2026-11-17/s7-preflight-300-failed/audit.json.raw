        "query": "EXISTS(SELECT $15 FROM public.upstream_accounts a WHERE a.id=NEW.account_id AND a.state=$16)\n  AND (EXISTS(SELECT $17 FROM public.upstream_account_balances b WHERE b.account_id=NEW.account_id AND b.balance_atoms<$18)\n   OR EXISTS(SELECT $19 FROM core_funding.balance_cells c WHERE c.account_id=NEW.account_id AND c.balance_atoms<c.reserved_atoms))",
