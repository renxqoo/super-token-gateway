DATABASE_URL=postgres://gateway:replace@127.0.0.1:55442/gateway_current
REDIS_URL=redis://127.0.0.1:56382
ADMIN_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
KEY_PEPPER=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace
PORT=8088
MOCK_PORT=9088
MOCK_CONTROL_TOKEN=replace-with-32-random-characters
ALLOW_PRIVATE_UPSTREAM=false
NODE_ENV=production

# Use a separate durable Redis. Production requires acknowledged AOF replicas.
QUEUE_REDIS_URL=redis://127.0.0.1:56383
QUEUE_REQUIRED_REPLICAS=2
QUEUE_ACK_TIMEOUT_MS=2000
TRUSTED_PROXY_CIDRS=
PRIVATE_UPSTREAM_CIDRS=
UPSTREAM_POOL_SIZE=1024
