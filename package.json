{
  "name": "super-token-gateway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.local --watch apps/gateway/src/main.ts",
    "start": "bun apps/gateway/src/main.ts",
    "mock": "bun --env-file=.env.local apps/mock-providers/src/main.ts",
    "infra:up": "docker compose --env-file .env.local -p super-token-gateway -f infra/compose.yaml up -d --wait",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.ts",
    "seed": "bun --env-file=.env.local scripts/seed.ts",
    "check": "bun check --no-script",
    "lint": "oxlint --deny-warnings",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "test": "bun run build:native && bun test tests/unit scripts/__test__ apps/gateway/src/__test__ packages/kernel/src/__test__ packages/contracts/src/__test__ packages/runtime/src/__test__ packages/connectors/src/__test__ packages/plugin-sdk/src/__test__ packages/plugin-host/src/__test__ packages/adapters/src/__test__ packages/core-client/src/__test__",
    "test:integration": "bun --env-file=.env.local test tests/integration --timeout 30000",
    "verify": "bun run check && bun run lint && bun run fmt:check && bun run build:native && bun run test:native && bun run test && bun run test:integration && bun run build && bun run test:plugin-artifact && bun run test:artifact",
    "build": "bun run build:native && bun scripts/build.ts",
    "bench": "bun --env-file=.env.local scripts/bench.ts",
    "references:snapshot": "bun scripts/reference-snapshot.ts",
    "worker": "bun --env-file=.env.local apps/gateway/src/worker-main.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "openapi": "bun scripts/openapi.ts",
    "test:artifact": "bun --env-file=.env.local scripts/verify-artifact.ts && bun --env-file=.env.local scripts/verify-catalog-artifact.ts && bun --env-file=.env.local scripts/verify-identity-artifact.ts && bun --env-file=.env.local scripts/verify-execution-artifact.ts",
    "test:container": "bun --env-file=.env.local scripts/verify-container.ts",
    "test:durability": "bun --env-file=.env.local scripts/verify-durability.ts",
    "test:backup": "bun --env-file=.env.local scripts/verify-backup.ts",
    "db:archive": "bun --env-file=.env.local scripts/archive.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "build:plugins": "bun scripts/build-plugins.ts",
    "build:native": "bun scripts/plugin-native.ts build",
    "test:native": "bun scripts/plugin-native.ts test",
    "test:native:race": "bun scripts/plugin-native.ts test --race",
    "test:plugins": "bun run build:native && bun test packages/plugin-sdk/src/__test__ packages/plugin-host/src/__test__ packages/adapters/src/__test__",
    "test:plugin-artifact": "bun scripts/verify-plugin-artifact.ts",
    "setup:plugin-tools": "bun scripts/build-plugins.ts --setup-tools",
    "plugins:sign-bundled": "bun scripts/sign-bundled-release.ts",
    "plugins:install-bundled": "bun scripts/install-bundled-release.ts",
    "core:identity": "bun --env-file=.env.local apps/core-api/src/identity-main.ts"
  },
  "devDependencies": {
    "@gateway/connectors": "workspace:*",
    "@gateway/contracts": "workspace:*",
    "@gateway/kernel": "workspace:*",
    "@gateway/runtime": "workspace:*",
    "@gateway/storage": "workspace:*",
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "oxlint": "1.93.0",
    "zod": "4.6.7",
    "@gateway/plugin-sdk": "workspace:*",
    "@gateway/plugin-host": "workspace:*",
    "@gateway/adapters": "workspace:*",
    "@gateway/core-client": "workspace:*"
  }
}
