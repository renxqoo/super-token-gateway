{
  "name": "super-token-gateway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.local scripts/dev.ts",
    "gateway": "bun --env-file=.env.local apps/gateway/src/main.ts",
    "worker": "bun --env-file=.env.local apps/worker/src/main.ts",
    "mock": "bun --env-file=.env.local apps/mock-providers/src/main.ts",
    "infra:up": "bun --env-file=.env.local scripts/native-services.ts start",
    "infra:down": "bun --env-file=.env.local scripts/native-services.ts stop",
    "infra:status": "bun --env-file=.env.local scripts/native-services.ts status",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.ts",
    "db:archive": "bun --env-file=.env.local scripts/archive.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "check": "bun check --no-script",
    "lint": "oxlint --deny-warnings",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "test": "bun test scripts/__test__ tests/unit packages/kernel/src/__test__ packages/contracts/src/__test__ packages/protocol/src/__test__ packages/runtime/src/__test__ packages/plugin-engine/src/__test__",
    "test:integration": "bun --env-file=.env.local test tests/integration --timeout 30000",
    "build": "bun scripts/build.ts",
    "build:wasmtime": "cargo build --release --manifest-path native/plugin-wasmtime/Cargo.toml",
    "build:plugins": "bun scripts/build-builtin-plugins.ts",
    "test:artifact": "bun --env-file=.env.local scripts/verify-artifact.ts",
    "test:durability": "bun --env-file=.env.local scripts/verify-durability.ts",
    "test:production": "bun --no-env-file scripts/verify-production.ts",
    "test:alerts": "bun --no-env-file scripts/verify-alert-delivery.ts",
    "openapi": "bun --no-env-file scripts/openapi.ts",
    "openapi:check": "bun --no-env-file scripts/openapi.ts --check",
    "bench": "bun --env-file=.env.local scripts/bench.ts",
    "bench:single": "bun --env-file=.env.local scripts/bench-single.ts",
    "bench:prod": "bun --env-file=.env.local scripts/bench-prod.ts",
    "verify": "bun run check && bun run lint && bun run fmt:check && bun run openapi:check && bun run test && bun run test:integration && bun run build && bun run test:artifact && bun run test:durability"
  },
  "devDependencies": {
    "@gateway/contracts": "workspace:*",
    "@gateway/gateway": "workspace:*",
    "@gateway/kernel": "workspace:*",
    "@gateway/ledger": "workspace:*",
    "@gateway/plugin-engine": "workspace:*",
    "@gateway/protocol": "workspace:*",
    "@gateway/runtime": "workspace:*",
    "@gateway/worker": "workspace:*",
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.93.0",
    "zod": "4.6.7"
  }
}
