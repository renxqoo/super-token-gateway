{
  "name": "super-token-gateway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.local --watch apps/gateway/src/main.ts",
    "start": "bun apps/gateway/src/main.ts",
    "mock": "bun --env-file=.env.local apps/mock-providers/src/main.ts",
    "infra:up": "docker compose --env-file .env.local -p super-token-gateway -f infra/compose.yaml up -d --wait",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.ts",
    "seed": "bun --env-file=.env.local scripts/seed.ts",
    "check": "bun check --no-script",
    "lint": "oxlint --deny-warnings",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "test": "bun test tests/unit",
    "test:integration": "bun --env-file=.env.local test tests/integration --timeout 30000",
    "verify": "bun run check && bun run lint && bun run fmt:check && bun run test && bun run test:integration && bun run build && bun run test:artifact",
    "build": "bun scripts/build.ts",
    "bench": "bun --env-file=.env.local scripts/bench.ts",
    "worker": "bun --env-file=.env.local apps/gateway/src/worker-main.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "openapi": "bun scripts/openapi.ts",
    "test:artifact": "bun --env-file=.env.local scripts/verify-artifact.ts",
    "test:container": "bun --env-file=.env.local scripts/verify-container.ts",
    "test:durability": "bun --env-file=.env.local scripts/verify-durability.ts",
    "test:backup": "bun --env-file=.env.local scripts/verify-backup.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.93.0",
    "@gateway/kernel": "workspace:*",
    "@gateway/storage": "workspace:*",
    "@gateway/runtime": "workspace:*",
    "@gateway/connectors": "workspace:*"
  }
}
