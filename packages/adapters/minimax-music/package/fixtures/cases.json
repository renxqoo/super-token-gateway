{
  "format": 1,
  "config": {
    "model_map": {
      "logical": "upstream"
    },
    "max_input_tokens": 10000,
    "auth": "bearer"
  },
  "cases": [
    {
      "name": "music request keeps every official field and changes only the model",
      "steps": [
        {
          "action": "json",
          "hook": "prepare",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJtb2RlbCI6ImxvZ2ljYWwiLCJwcm9tcHQiOiLovbvlv6vnmoTpkqLnkLQiLCJseXJpY3MiOiJbVmVyc2VdXG7kvaDlpb0iLCJhdWRpb19zZXR0aW5nIjp7InNhbXBsZV9yYXRlIjo0NDEwMCwiYml0cmF0ZSI6MjU2MDAwLCJmb3JtYXQiOiJtcDMifSwib3V0cHV0X2Zvcm1hdCI6ImhleCJ9",
          "expected": {
            "abi_version": 1,
            "kind": "prepared",
            "request": {
              "method": "POST",
              "path": "/v1/music_generation",
              "headers": {
                "accept": "application/json"
              },
              "auth": {
                "type": "bearer"
              },
              "manifest": {
                "operation": "music",
                "model": "logical",
                "upstream_model": "upstream",
                "stream": false,
                "ceilings": {
                  "requests": "1"
                },
                "input_bytes": 165
              }
            }
          },
          "expected_body": "eyJtb2RlbCI6InVwc3RyZWFtIiwicHJvbXB0Ijoi6L275b+r55qE6ZKi55C0IiwibHlyaWNzIjoiW1ZlcnNlXVxu5L2g5aW9IiwiYXVkaW9fc2V0dGluZyI6eyJzYW1wbGVfcmF0ZSI6NDQxMDAsImJpdHJhdGUiOjI1NjAwMCwiZm9ybWF0IjoibXAzIn0sIm91dHB1dF9mb3JtYXQiOiJoZXgifQ=="
        }
      ]
    },
    {
      "name": "streaming music is refused until its wire format is confirmed",
      "steps": [
        {
          "action": "json",
          "hook": "prepare",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJtb2RlbCI6ImxvZ2ljYWwiLCJwcm9tcHQiOiJ4Iiwic3RyZWFtIjp0cnVlfQ==",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 422,
            "code": "unsupported_semantics"
          }
        }
      ]
    },
    {
      "name": "url output is refused until its response field is confirmed",
      "steps": [
        {
          "action": "json",
          "hook": "prepare",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJtb2RlbCI6ImxvZ2ljYWwiLCJwcm9tcHQiOiJ4Iiwib3V0cHV0X2Zvcm1hdCI6InVybCJ9",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 422,
            "code": "unsupported_semantics"
          }
        }
      ]
    },
    {
      "name": "cover references and unknown fields are refused",
      "steps": [
        {
          "action": "json",
          "hook": "prepare",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJtb2RlbCI6ImxvZ2ljYWwiLCJwcm9tcHQiOiJ4IiwiYXVkaW9fdXJsIjoiaHR0cHM6Ly9leGFtcGxlLmludmFsaWQvYS5tcDMifQ==",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 422,
            "code": "unsupported_semantics"
          }
        }
      ]
    },
    {
      "name": "an unmapped model is unavailable",
      "steps": [
        {
          "action": "json",
          "hook": "prepare",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJtb2RlbCI6Im90aGVyIiwicHJvbXB0IjoieCJ9",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 422,
            "code": "model_unavailable"
          }
        }
      ]
    },
    {
      "name": "completed music is metered in milliseconds from music_duration",
      "steps": [
        {
          "action": "json",
          "hook": "response",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "chunks": [],
            "usage": {
              "music_ms": "25364",
              "requests": "1"
            },
            "finality": "FINAL",
            "terminal": {
              "kind": "complete",
              "bytes": ""
            }
          },
          "expected_body": ""
        }
      ]
    },
    {
      "name": "music without a duration is delivered with unknown usage",
      "steps": [
        {
          "action": "json",
          "hook": "response",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJkYXRhIjp7ImF1ZGlvIjoiNDk0NCIsInN0YXR1cyI6Mn0sImJhc2VfcmVzcCI6eyJzdGF0dXNfY29kZSI6MCwic3RhdHVzX21zZyI6InN1Y2Nlc3MifX0=",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "usage": {
              "requests": "1"
            },
            "finality": "UNKNOWN"
          }
        }
      ]
    },
    {
      "name": "a nonzero base_resp status is an upstream error",
      "steps": [
        {
          "action": "json",
          "hook": "response",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJkYXRhIjpudWxsLCJiYXNlX3Jlc3AiOnsic3RhdHVzX2NvZGUiOjEwMDgsInN0YXR1c19tc2ciOiJpbnN1ZmZpY2llbnQgYmFsYW5jZSJ9fQ==",
          "expected": {
