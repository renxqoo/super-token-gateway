      "steps": [
        {
          "action": "json",
          "hook": "response",
          "metadata": {
            "operation": "music",
            "model": "logical"
          },
          "body": "eyJkYXRhIjp7ImF1ZGlvIjoiIiwic3RhdHVzIjoyfSwiYmFzZV9yZXNwIjp7InN0YXR1c19jb2RlIjowLCJzdGF0dXNfbXNnIjoic3VjY2VzcyJ9fQ==",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 502,
