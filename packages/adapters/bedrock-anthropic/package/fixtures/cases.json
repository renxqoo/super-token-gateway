{
  "format": 1,
  "config": {
    "model_map": {
      "logical": "anthropic.claude-upstream:0"
    },
    "max_output_tokens": 100,
    "max_input_tokens": 10000,
    "auth": "aws-sigv4"
  },
  "cases": [
    {
      "name": "chat request becomes a signed Bedrock invoke-with-response-stream body without model or stream",
      "steps": [
        {
          "action": "json",
          "hook": "prepare",
          "metadata": {
            "protocol": "chat",
            "operation": "chat",
            "model": "logical"
          },
          "body": "eyJtb2RlbCI6ImxvZ2ljYWwiLCJtZXNzYWdlcyI6W3sicm9sZSI6InVzZXIiLCJjb250ZW50Ijoi5L2g5aW9In1dLCJzdHJlYW0iOnRydWV9",
          "expected": {
            "abi_version": 1,
            "kind": "prepared",
            "request": {
              "method": "POST",
              "path": "/model/anthropic.claude-upstream%3A0/invoke-with-response-stream",
              "headers": {
                "accept": "application/json",
                "x-amzn-bedrock-accept": "application/json"
              },
              "auth": {
                "type": "aws-sigv4",
                "service": "bedrock"
              },
              "manifest": {
                "operation": "chat",
                "model": "logical",
                "upstream_model": "anthropic.claude-upstream:0",
                "stream": true,
                "ceilings": {
                  "input_tokens": "10000",
                  "output_tokens": "100",
                  "requests": "1"
                },
                "input_bytes": 81
              }
            }
          },
          "expected_body": "eyJhbnRocm9waWNfdmVyc2lvbiI6ImJlZHJvY2stMjAyMy0wNS0zMSIsIm1heF90b2tlbnMiOjEwMCwibWVzc2FnZXMiOlt7InJvbGUiOiJ1c2VyIiwiY29udGVudCI6IuS9oOWlvSJ9XX0="
        }
      ]
    },
    {
      "name": "invoke response becomes a chat completion with exact cache usage",
      "steps": [
        {
          "action": "json",
          "hook": "response",
          "metadata": {
            "protocol": "chat",
            "operation": "chat",
            "model": "logical"
          },
          "body": "",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "usage": {
              "input_tokens": "9007199254740993",
              "output_tokens": "2",
              "cached_input_tokens": "3",
              "cache_write_tokens": "4"
            },
            "finality": "FINAL",
            "terminal": {
              "kind": "complete",
              "bytes": ""
            },
            "needs_input": false
          },
          "expected_body": ""
        }
      ]
    },
    {
      "name": "event stream chunks become chat chunks and withhold the finish, usage and DONE as the terminal",
      "steps": [
        {
          "action": "invoke",
          "hook": "stream_open",
          "input": "eyJtb2RlbCI6ImxvZ2ljYWwifQ==",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 0,
            "chunks": [],
            "finality": "UNKNOWN",
            "needs_input": true
          }
        },
        {
          "action": "invoke",
          "hook": "stream_feed",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 1436,
            "chunks": [
              "ZGF0YTogeyJpZCI6Im1zZ18xIiwib2JqZWN0IjoiY2hhdC5jb21wbGV0aW9uLmNodW5rIiwiY3JlYXRlZCI6MCwibW9kZWwiOiJsb2dpY2FsIiwiY2hvaWNlcyI6W3siaW5kZXgiOjAsImRlbHRhIjp7InJvbGUiOiJhc3Npc3RhbnQiLCJjb250ZW50IjoiIn0sImZpbmlzaF9yZWFzb24iOm51bGx9XX0KCg==",
              "ZGF0YTogeyJpZCI6Im1zZ18xIiwib2JqZWN0IjoiY2hhdC5jb21wbGV0aW9uLmNodW5rIiwiY3JlYXRlZCI6MCwibW9kZWwiOiJsb2dpY2FsIiwiY2hvaWNlcyI6W3siaW5kZXgiOjAsImRlbHRhIjp7ImNvbnRlbnQiOiLkvaDlpb3wn4yPIn0sImZpbmlzaF9yZWFzb24iOm51bGx9XX0KCg=="
            ],
            "finality": "FINAL",
            "needs_input": false,
            "usage": {
              "input_tokens": "9007199254740993",
              "output_tokens": "2"
            },
            "terminal": {
              "kind": "complete",
              "bytes": ""
            }
          }
        },
        {
          "action": "invoke",
          "hook": "stream_finish",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 0,
            "chunks": [],
            "finality": "FINAL",
            "needs_input": false,
            "usage": {
              "input_tokens": "9007199254740993",
              "output_tokens": "2"
            }
          }
        }
      ]
    },
    {
      "name": "a corrupted event stream message is an invalid stream",
      "steps": [
        {
          "action": "invoke",
          "hook": "stream_open",
          "input": "eyJtb2RlbCI6ImxvZ2ljYWwifQ==",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 0,
            "chunks": [],
            "finality": "UNKNOWN",
            "needs_input": true
          }
        },
        {
          "action": "invoke",
          "hook": "stream_feed",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 502,
            "code": "invalid_stream"
          }
        }
      ]
    },
    {
      "name": "an exception message mid stream cannot become success",
      "steps": [
        {
          "action": "invoke",
          "hook": "stream_open",
          "input": "eyJtb2RlbCI6ImxvZ2ljYWwifQ==",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 0,
            "chunks": [],
            "finality": "UNKNOWN",
            "needs_input": true
          }
        },
        {
          "action": "invoke",
          "hook": "stream_feed",
          "input": "AAAAiAAAAGHeAXX0DTptZXNzYWdlLXR5cGUHAAlleGNlcHRpb24POmV4Y2VwdGlvbi10eXBlBwATdGhyb3R0bGluZ0V4Y2VwdGlvbg06Y29udGVudC10eXBlBwAQYXBwbGljYXRpb24vanNvbnsibWVzc2FnZSI6InNsb3cgZG93biJ9TkO5WA==",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 502,
            "code": "invalid_stream"
          }
        }
      ]
    },
    {
      "name": "EOF inside an event stream message is a truncation",
      "steps": [
        {
          "action": "invoke",
          "hook": "stream_open",
          "input": "eyJtb2RlbCI6ImxvZ2ljYWwifQ==",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 0,
            "chunks": [],
            "finality": "UNKNOWN",
            "needs_input": true
          }
        },
        {
          "action": "invoke",
          "hook": "stream_feed",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 329,
            "chunks": [],
            "needs_input": true
          }
        },
        {
          "action": "invoke",
          "hook": "stream_finish",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 502,
            "code": "stream_truncated"
          }
        }
      ]
    },
    {
      "name": "cancellation invalidates context",
      "steps": [
        {
          "action": "invoke",
          "hook": "stream_open",
          "input": "eyJtb2RlbCI6ImxvZ2ljYWwifQ==",
          "expected": {
            "abi_version": 1,
            "kind": "output",
            "consumed": 0,
            "chunks": [],
            "finality": "UNKNOWN",
            "needs_input": true
          }
        },
        {
          "action": "cancel",
          "hook": "stream_feed",
          "input": "",
          "expected_error": "CALL_CANCELLED"
        }
      ]
    },
    {
      "name": "balance explicitly unsupported",
      "steps": [
        {
          "action": "invoke",
          "hook": "balance_prepare",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 422,
            "code": "unsupported_capability"
          }
        }
      ]
    },
    {
      "name": "resource explicitly unsupported",
      "steps": [
        {
          "action": "invoke",
          "hook": "resource_prepare",
          "input": "",
          "expected": {
            "abi_version": 1,
            "kind": "failure",
            "status": 422,
            "code": "unsupported_capability"
          }
        }
      ]
    }
  ]
}
