{
  "format": 1,
  "id": "gateway.openai-chat",
  "version": "1.7.0",
  "abi_version": 1,
  "sdk_version": "1.0.0",
  "module": "module.wasm",
  "entrypoint": "invoke",
  "config_schema": "config.schema.json",
  "capabilities": {
    "operations": [
      "chat",
      "responses",
      "embeddings",
      "moderations",
      "completions",
      "images",
      "image_edits",
      "speech",
      "transcription",
      "translation",
      "files"
    ],
    "dimensions": [
      "input_tokens",
      "output_tokens",
      "cached_input_tokens",
      "reasoning_tokens",
      "requests",
      "images",
      "characters",
      "audio_ms",
      "audio_seconds"
    ],
    "protocols": ["chat", "responses"],
    "hooks": [
      "describe",
      "prepare",
      "response",
      "error",
      "stream_open",
      "stream_feed",
      "stream_drain",
      "stream_finish",
      "stream_dispose",
      "resource_prepare",
      "resource_response"
    ],
    "auth": ["none", "bearer", "api-key"],
    "resources": true,
    "balance": false,
    "stream_codec": "sse"
  }
}
