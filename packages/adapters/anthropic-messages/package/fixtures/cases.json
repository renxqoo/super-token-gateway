              },
              "manifest": {
                "operation": "chat",
                "model": "logical",
                "upstream_model": "claude-upstream",
                "stream": false,
                "ceilings": {
                  "input_tokens": "10000",
                  "output_tokens": "100",
                  "requests": "1"
                },
                "input_bytes": 573
              }
            }
          },
          "expected_body": ""
        }
      ]
