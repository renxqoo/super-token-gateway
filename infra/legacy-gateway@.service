[Unit]
Description=Legacy LLM Gateway instance %i (transitional for unmigrated routes; removed with legacy)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=llm-legacy-gateway
Group=llm-legacy-gateway
WorkingDirectory=/opt/llm-gateway/current
EnvironmentFile=/etc/llm-gateway/legacy-%i.env
ExecStart=/usr/local/bin/bun dist/legacy-gateway/main.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=131072
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
[Install]
WantedBy=multi-user.target
