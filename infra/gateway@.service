[Unit]
Description=Super Token Gateway Node %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=llm-gateway
Group=llm-gateway
WorkingDirectory=/opt/super-token-gateway
Environment=BUN_CONFIG_MAX_HTTP_REQUESTS=4096
EnvironmentFile=/etc/super-token-gateway/gateway-%i.env
ExecStart=/usr/local/bin/bun dist/gateway/main.js --mode=gateway
Restart=always
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
