[Unit]
Description=Independent LLM Gateway instance %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=llm-gateway
Group=llm-gateway
WorkingDirectory=/opt/llm-gateway/current
EnvironmentFile=/etc/llm-gateway/%i.env
ExecStart=/usr/local/bin/bun dist/gateway/main.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=131072
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
[Install]
WantedBy=multi-user.target
