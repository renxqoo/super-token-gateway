NODE_ENV=production
GATEWAY_MODE=gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=8081
DATABASE_URL=postgres://stg_gateway_login:CHANGE_ME@postgres-writer.internal:5432/gateway_prod
INTERNAL_DATABASE_URL=postgres://stg_control_login:CHANGE_ME@postgres-writer.internal:5432/gateway_prod
DB_MAX_CONNECTIONS=32
INTERNAL_DB_MAX_CONNECTIONS=4
REDIS_URL=rediss://redis-writer.internal:6379
REDIS_NAMESPACE=stg_prod
ACCESS_LOG=true
TRACE_METRICS=true
TRACE_DATABASE_URL=
TRACE_SAMPLE_BPS=100
TRACE_SLOW_FIRST_TEXT_MS=3000
TRACE_ATTEMPTS_PER_REQUEST=16
TRACE_ERROR_BODY_BYTES=8192
TRACE_QUEUE_RECORDS=2048
TRACE_QUEUE_BYTES=16777216
TRACE_QUEUE_PER_BILLING_ACCOUNT=256
TRACE_QUEUE_PRIORITY_RESERVE=256
TRACE_BATCH_RECORDS=64
TRACE_BATCH_DEADLINE_MS=8000
TRACE_FLUSH_MS=250
TRACE_DB_TIMEOUT_MS=2500
TRACE_RETRY_LIMIT=1
TRACE_RETENTION_SECONDS=604800
TRACE_CLEANUP_INTERVAL_MS=60000
TRACE_CLEANUP_BATCH_SPANS=1024
KEY_PEPPER=CHANGE_ME_AT_LEAST_32_CHARS_HEX
ENCRYPTION_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARACTERS
INTERNAL_AUTH_FILE=/etc/super-token-gateway/internal-auth.json
ALLOW_PRIVATE_UPSTREAMS=false
MAX_IN_FLIGHT=2000
INGRESS_IP_MODE=off
INGRESS_PRESSURE_MODE=off
UPSTREAM_DIAL_CONCURRENCY=16
UPSTREAM_DIAL_RPS=400
UPSTREAM_DIAL_QUEUE_WAIT_MS=10000
UPSTREAM_DIAL_QUEUE_BYTES=67108864
BODY_READ_TIMEOUT_MS=15000
GATEWAY_REUSE_PORT=false
HOLD_TTL_MS=60000
ATTEMPT_TIMEOUT_MS=30000
STREAM_MAX_DURATION_MS=300000
SNAPSHOT_POLL_MS=2000
MICRO_BATCH_WINDOW_MS=2
MICRO_BATCH_MAX_SIZE=256
WALLET_LEASE_IDLE_RELEASE_MS=450
