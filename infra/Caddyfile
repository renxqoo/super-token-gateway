# Replace the hostname and local ports for your deployment. Admin stays private.
gateway.example.com {
	encode zstd gzip
	@chat {
		method POST
		path /v1/chat/completions /v1/messages /v1/responses /v1/embeddings /v1/moderations /v1/completions /v1/images/generations /v1/images/edits /v1/audio/speech /v1/audio/transcriptions /v1/audio/translations /v1/music/generations /v1beta/models/*
	}
	handle @chat {
		reverse_proxy 127.0.0.1:8090 127.0.0.1:8091 {
			lb_policy least_conn
			health_uri /readyz
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			flush_interval -1
			# No transparent proxy replay of POST, including after unknown upstream execution.
			lb_try_duration 0s
		}
	}
	@resources path /v1/responses /v1/responses/* /v1/files /v1/files/* /v1/batches /v1/batches/* /v1/videos /v1/videos/*
	handle @resources {
		reverse_proxy 127.0.0.1:8090 127.0.0.1:8091 {
			lb_policy least_conn
			health_uri /readyz
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			lb_try_duration 0s
		}
	}
	@account path /v1/wallets /v1/models /v1beta/models /v1/usage /v1/project/keys /v1/project/keys/*
	@request path_regexp ^/v1/requests/[^/]+(/billing)?$
	handle @account {
		reverse_proxy 127.0.0.1:8095 {
			health_uri /readyz
			health_interval 5s
			health_timeout 2s
			lb_try_duration 0s
		}
	}
	handle @request {
		reverse_proxy 127.0.0.1:8095 {
			health_uri /readyz
			health_interval 5s
			health_timeout 2s
			lb_try_duration 0s
		}
	}
	@legacy path /v1/* /v1beta/*
	handle @legacy {
		reverse_proxy 127.0.0.1:8088 127.0.0.1:8089 {
			lb_policy least_conn
			health_uri /readyz
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			flush_interval -1
			lb_try_duration 0s
		}
	}
	handle {
		respond "Not found" 404
	}
	# Do not enable request/response body logging, buffering plugins or response caches.
}
