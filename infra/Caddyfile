:443 {
	@public_api {
		method GET POST
		path /v1/models /v1/chat/completions /v1/responses /v1/messages /v1/embeddings /v1/moderations /v1/completions /v1/images/generations /v1/images/edits /v1/audio/speech /v1/audio/transcriptions /v1/audio/translations /v1beta/models/*
	}

	@health {
		method GET
		path /livez /readyz
	}

	handle @public_api {
		reverse_proxy 127.0.0.1:8080 127.0.0.1:8082 {
			lb_policy least_conn
			health_uri /readyz
			health_interval 5s
			flush_interval -1
		}
	}

	handle @health {
		reverse_proxy 127.0.0.1:8080 127.0.0.1:8082 {
			lb_policy round_robin
		}
	}

	handle {
		respond "Not found" 404
	}
}
